---
// The gift card as it looks on screen: edition artwork + studio mark + value.
// Text inside is filled/updated by page scripts through the data-gc-* hooks.
const { image, edition, amount = '', name = '', id = '' } = Astro.props;
---
<div class="gcv" id={id || undefined} style={`--art:url('${image}')`}>
  <div class="gcv-top">
    <img class="gcv-logo" src="/images/brand/LOGO_white_TransparentBG.png" alt="" aria-hidden="true" />
    <span class="gcv-brand">Usee<span>·</span>Tattoo</span>
  </div>
  <div class="gcv-bottom">
    <div>
      <div class="gcv-ed" data-gc-edition>{edition}</div>
      <div class="gcv-for" data-gc-name>{name}</div>
    </div>
    <div class="gcv-amt" data-gc-amount>{amount}</div>
  </div>
</div>
<style>
  .gcv{position:relative;aspect-ratio:148/105;width:100%;background:#0e0d0d var(--art) center/cover no-repeat;color:var(--paper);
    padding:6% 7%;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 30px 60px -28px rgba(14,13,13,.55),0 2px 0 rgba(255,255,255,.04) inset;overflow:hidden}
  .gcv::after{content:"";position:absolute;inset:3.2%;border:1px solid rgba(138,115,85,.45);pointer-events:none}
  .gcv-top{display:flex;align-items:center;gap:12px;position:relative;z-index:1}
  .gcv-logo{width:clamp(18px,3.4vw,30px);height:auto;opacity:.92}
  .gcv-brand{font-family:'Cormorant Garamond',serif;font-size:clamp(13px,1.9vw,19px);letter-spacing:.28em;text-transform:uppercase}
  .gcv-brand span{color:var(--bronze)}
  .gcv-bottom{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;position:relative;z-index:1}
  .gcv-ed{font-size:clamp(9px,1.1vw,11px);letter-spacing:.3em;text-transform:uppercase;color:#dcccb0}
  .gcv-for{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(16px,2.4vw,26px);color:#e8ddca;min-height:1.2em;margin-top:4px}
  .gcv-amt{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:clamp(34px,6vw,64px);line-height:.9;white-space:nowrap}
</style>
