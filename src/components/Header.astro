---
import { t } from '../data/i18n.js';
import { site } from '../data/site.js';
import { styles } from '../data/styles.js';
import { artists } from '../data/artists.js';
const { lang, altPath, altLabel } = Astro.props;
const L = t[lang];
const base = `/${lang}`;
---
<header id="hd">
<div class="wrap nav">
<a href={`${base}/`} class="brand">Usee<span>·</span>Tattoo</a>
<nav>
<ul>
<li><a href={`${base}/`}>{L.nav.home}</a></li>
{/* BIKE DAYS promo nav item (temporary, remove after 29 Nov 2026) */}
<li class="nav-bikedays"><a href="/bikedays/">Bike&nbsp;Days<span class="nav-dot" aria-hidden="true"></span></a></li>
<li class="has-sub">
<a class="sub-parent" href={`${base}/#artists`}>{L.nav.artists}<span class="sub-caret" aria-hidden="true">+</span></a>
<ul class="submenu">
{artists.map((a) => <li><a href={`${base}/artists/${a.slug}/`}>{a.name}</a></li>)}
</ul>
</li>
<li class="has-sub">
<a class="sub-parent" href={`${base}/#styles`}>{L.nav.styles}<span class="sub-caret" aria-hidden="true">+</span></a>
<ul class="submenu">
{styles.map((s) => <li><a href={`${base}/styles/${s.slug}/`}>{s.name[lang]}</a></li>)}
</ul>
</li>
<li><a href={`${base}/erstes-tattoo/`}>{L.nav.firstTattoo}</a></li>
<li class="has-sub">
<a class="sub-parent" role="button" tabindex="0">{L.nav.services}<span class="sub-caret" aria-hidden="true">+</span></a>
<ul class="submenu">
<li><a href={`${base}/booking/`}>{L.nav.booking}</a></li>
<li><a href={`${base}/consultation/`}>{L.nav.consultation}</a></li>
<li><a href={`${base}/walk-in/`}>{L.nav.walkin}</a></li>
<li><a href={`${base}/piercing/`}>{L.nav.piercing}</a></li>
<li><a href={`${base}/cover-up/`}>{L.nav.coverup}</a></li>
<li><a href={`${base}/gift-cards/`}>{lang === 'de' ? 'Gutscheine' : 'Gift Cards'}</a></li>
</ul>
</li>
<li class="has-sub">
<a class="sub-parent" role="button" tabindex="0">{L.nav.events}<span class="sub-caret" aria-hidden="true">+</span></a>
<ul class="submenu">
<li><a href={`${base}/events/event-activations/`}>Event Activations</a></li>
<li><a href={`${base}/events/guest-artists/`}>{L.navGuestArtists}</a></li>
<li><a href={`${base}/events/past-events/`}>{L.navPastEvents}</a></li>
</ul>
</li>
<li><a href={`${base}/about/`}>{L.nav.about}</a></li>
<li><a href={`${base}/faq/`}>{L.nav.faq}</a></li>
<li><a href={`${base}/contact/`}>{L.nav.contact}</a></li>
</ul>
</nav>
<div class="nav-right">
<a class="lang-switch" href={altPath} hreflang={altLabel.toLowerCase()}>{altLabel}</a>
<button class="burger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
</div>
</div>
</header>

{/* BIKE DAYS promo styling (temporary, remove after 29 Nov 2026) */}
<style>
  .nav-bikedays a{color:var(--paper);font-weight:500}
  .nav-bikedays a:hover{color:var(--paper)}
  .nav-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#e60000;
    margin-left:7px;vertical-align:middle;box-shadow:0 0 0 0 rgba(230,0,0,.6);animation:bdDot 1.8s ease-out infinite}
  @keyframes bdDot{0%{box-shadow:0 0 0 0 rgba(230,0,0,.55)}70%{box-shadow:0 0 0 7px rgba(230,0,0,0)}100%{box-shadow:0 0 0 0 rgba(230,0,0,0)}}
</style>
