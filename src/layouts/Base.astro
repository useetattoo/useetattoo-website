---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickForm from '../components/QuickForm.astro';
import { site } from '../data/site.js';

const { lang = 'de', title, description, ogImage } = Astro.props;
const ck = {
  de: {
    text: 'Wir verwenden Cookies. Technisch notwendige sind immer aktiv. Andere Dienste (z. B. Google Tag Manager, Google Maps) laden wir nur mit deiner Einwilligung. Mehr in unserer',
    privacy: 'Datenschutzerklärung',
    accept: 'Akzeptieren',
    decline: 'Nur notwendige',
  },
  en: {
    text: 'We use cookies. Technically necessary ones are always active. Other services (e.g. Google Tag Manager, Google Maps) are only loaded with your consent. More in our',
    privacy: 'Privacy Policy',
    accept: 'Accept',
    decline: 'Only necessary',
  },
}[lang];
const alt = lang === 'de' ? 'en' : 'de';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
// Pages that already have their own dedicated form: don't add the global quick form
const hasOwnForm = /\/(contact|cover-up)$/.test(pathname);
const selfPath = pathname;
const altPath = pathname.replace(new RegExp(`^/${lang}`), `/${alt}`);
const canonical = site.domain + selfPath + (selfPath === '/' ? '' : '/');
const og = ogImage || site.heroImage;

// LocalBusiness structured data (schema.org), sitewide. Uses the same
// site.js source of truth as the header/footer contact info, so it can
// never drift out of sync with the real NAP shown on the page.
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'TattooParlor',
  '@id': `${site.domain}/#business`,
  name: site.name,
  image: site.domain + site.heroImage,
  url: site.domain + '/de/',
  telephone: site.phone.display,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.zip,
    addressCountry: 'DE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 52.506937, longitude: 13.2919169 },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '11:00',
    closes: '19:00',
  },
  sameAs: [site.social.instagram, site.social.facebook, site.social.tiktok, site.social.pinterest],
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="p:domain_verify" content="ea34f2a1f57b9444b892812eb987641d"/>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="de" href={site.domain + (selfPath.replace(new RegExp(`^/${lang}`), '/de'))} />
  <link rel="alternate" hreflang="en" href={site.domain + (selfPath.replace(new RegExp(`^/${lang}`), '/en'))} />
  <link rel="alternate" hreflang="x-default" href={site.domain + '/de/'} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="UseeTattoo" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={site.domain + og} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <!-- Google Consent Mode v2: the GTM container always loads for every visitor
       (needed so Google's own tag-detection tools and Google Ads can find our
       tag at all), but ad/analytics storage stays "denied" by default until the
       visitor actually accepts cookies in the banner below. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
    try {
      if (localStorage.getItem('usee-cookie-consent') === 'granted') {
        gtag('consent', 'update', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
        });
      }
    } catch (e) {}
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-TFXZ2D2F');
  </script>
  <style is:global>
    /* Cookie consent banner */
    .cookie-banner{position:fixed;left:0;right:0;bottom:0;z-index:9000;background:var(--ink);color:var(--paper);
      transform:translateY(110%);transition:transform .5s cubic-bezier(.22,1,.36,1);box-shadow:0 -8px 40px rgba(0,0,0,.25)}
    .cookie-banner.show{transform:translateY(0)}
    .ck-inner{max-width:1200px;margin:0 auto;padding:20px 28px;display:flex;align-items:center;gap:28px;flex-wrap:wrap;justify-content:space-between}
    .ck-text{font-family:'Inter',sans-serif;font-size:13.5px;line-height:1.6;margin:0;max-width:820px;color:rgba(255,255,255,.86)}
    .ck-text a{color:var(--paper);text-decoration:underline;text-underline-offset:2px}
    .ck-actions{display:flex;gap:12px;flex-shrink:0}
    .ck-btn{font-family:'Inter',sans-serif;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:12px 22px;border:1px solid rgba(255,255,255,.4);
      background:transparent;color:var(--paper);cursor:pointer;border-radius:0;transition:all .3s var(--ease)}
    .ck-btn:hover{border-color:var(--paper)}
    .ck-accept{background:var(--paper);color:var(--ink);border-color:var(--paper);font-weight:600}
    .ck-accept:hover{background:var(--bronze);border-color:var(--bronze);color:var(--ink)}
    @media(max-width:640px){.ck-inner{padding:16px 18px;gap:14px}.ck-actions{width:100%}.ck-btn{flex:1;padding:12px 10px}}
    /* Footer legal links */
    .foot-legal{display:inline-flex;align-items:center;gap:10px;flex-wrap:wrap}
    .foot-legal a,.cookie-settings-link{color:inherit;opacity:.75;transition:opacity .3s var(--ease)}
    .foot-legal a:hover,.cookie-settings-link:hover{opacity:1}
    .cookie-settings-link{background:none;border:0;padding:0;font:inherit;cursor:pointer;text-decoration:underline;text-underline-offset:2px}
    /* Legal pages */
    .legal-page{padding-top:140px}
    .legal-wrap{max-width:820px;margin:0 auto}
    .legal-wrap h1{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(38px,6vw,60px);line-height:1.05;margin:12px 0 28px}
    .legal-wrap h2{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(21px,3vw,27px);margin:38px 0 12px;color:var(--ink)}
    .legal-wrap p{font-family:'Inter',sans-serif;font-size:15.5px;line-height:1.8;color:var(--ink-soft);margin:0 0 14px}
    .legal-wrap a{color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px;word-break:break-word}
    .legal-wrap .lg-block{color:var(--ink)}
    .legal-wrap .lg-lead{font-size:17px;color:var(--ink)}
    .legal-wrap .lg-stand{font-size:13px;color:var(--bronze-dk);margin-bottom:8px}
    .legal-wrap .lg-note{margin-top:34px;padding-top:20px;border-top:1px solid var(--line);font-size:14px}
    /* Consent-gated embeds (e.g. Google Maps) */
    .consent-embed{position:relative}
    .consent-embed .consent-ph{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
      text-align:center;padding:24px;background:var(--paper-2);border:1px solid var(--line)}
    .consent-embed .consent-ph p{font-family:'Inter',sans-serif;font-size:13.5px;color:var(--ink-soft);max-width:360px;margin:0;line-height:1.6}
    .consent-embed.loaded .consent-ph{display:none}
  </style>
</head>
<body class={lang}>
  <div id="page-loader"><span class="pl-mark">Usee<span>·</span>Tattoo</span></div>
  <div class="backdrop" id="backdrop"></div>
  <Header lang={lang} altPath={altPath} altLabel={alt.toUpperCase()} />
  <main>
    <slot />
  </main>
  {!hasOwnForm && <QuickForm lang={lang} />}
  <Footer lang={lang} />

  <div class="cookie-banner" id="cookieBanner" role="dialog" aria-label="Cookie" hidden>
    <div class="ck-inner">
      <p class="ck-text">{ck.text} <a href={`/${lang}/datenschutz`}>{ck.privacy}</a>.</p>
      <div class="ck-actions">
        <button type="button" class="ck-btn ck-decline" data-consent="denied">{ck.decline}</button>
        <button type="button" class="ck-btn ck-accept" data-consent="granted">{ck.accept}</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var KEY = 'usee-cookie-consent';
      var banner = document.getElementById('cookieBanner');
      function getV(){ try { return localStorage.getItem(KEY); } catch (e) { return null; } }
      function loadEmbeds(){
        document.querySelectorAll('iframe[data-consent-src]').forEach(function (f) {
          if (!f.getAttribute('src')) f.setAttribute('src', f.getAttribute('data-consent-src'));
          var box = f.closest('.consent-embed'); if (box) box.classList.add('loaded');
        });
      }
      function apply(v){
        if (v === 'granted') {
          if (window.gtag) window.gtag('consent', 'update', { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', analytics_storage: 'granted' });
          loadEmbeds();
        } else if (v === 'denied' && window.gtag) {
          window.gtag('consent', 'update', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
        }
      }
      function hide(){ if (banner) { banner.classList.remove('show'); banner.hidden = true; } }
      function show(){ if (banner) { banner.hidden = false; requestAnimationFrame(function(){ banner.classList.add('show'); }); } }
      function setV(v){ try { localStorage.setItem(KEY, v); } catch (e) {} hide(); apply(v); }
      var cur = getV();
      if (cur === 'granted') apply('granted');
      else if (cur !== 'denied') show();
      if (banner) banner.querySelectorAll('[data-consent]').forEach(function (b) {
        b.addEventListener('click', function () { setV(b.getAttribute('data-consent')); });
      });
      document.querySelectorAll('[data-cookie-settings]').forEach(function (el) {
        el.addEventListener('click', function (e) { e.preventDefault(); show(); });
      });
      document.querySelectorAll('[data-load-embeds]').forEach(function (el) {
        el.addEventListener('click', function (e) { e.preventDefault(); setV('granted'); });
      });
    })();
  </script>

  <div class="floating-contact">
    <a class="fab call" href={site.phone.href} aria-label={lang === 'de' ? 'Anrufen' : 'Call'} title={lang === 'de' ? 'Anrufen' : 'Call'}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
    </a>
    <a class="fab wa" href={site.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01s-.52.07-.8.37c-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2z"/></svg>
    </a>
  </div>

  <div class="lb" id="lb"><span class="x" id="lbx">&times;</span><img id="lbimg" alt="" /></div>

  <script is:inline>
    (function(){
      var body=document.body;
      // page loader , reveal the page once loaded (capped so it never hangs on slow embeds)
      try{
        var pl=document.getElementById('page-loader');
        if(pl){
          var hidePl=function(){ pl.classList.add('hide'); };
          if(document.readyState==='complete'){ hidePl(); }
          else { addEventListener('load',hidePl); }
          setTimeout(hidePl,2500);
        }
      }catch(e){}
      // header shadow on scroll
      try{
        var hd=document.querySelector('header');
        addEventListener('scroll',function(){ if(hd) hd.classList.toggle('scrolled',scrollY>20); });
      }catch(e){}
      // mobile menu (runs first, isolated so nothing can break it)
      try{
        var burger=document.getElementById('burger');
        var backdrop=document.getElementById('backdrop');
        var closeMenu=function(){ body.classList.remove('menu-open'); };
        if(burger){
          burger.addEventListener('click',function(ev){ ev.preventDefault(); body.classList.toggle('menu-open'); });
        }
        if(backdrop){ backdrop.addEventListener('click',closeMenu); }
        // On mobile, tapping a parent item with a submenu toggles it instead of navigating.
        // Parents that already have a real destination (e.g. Artists -> #artists section)
        // navigate normally; only parents without an href (pure category pickers like
        // Styles/Services/Events) intercept the tap to open/close their submenu.
        document.querySelectorAll('.has-sub').forEach(function(hs){
          var pa=hs.querySelector(':scope > a');
          if(pa && !pa.getAttribute('href')){ pa.addEventListener('click',function(ev){
            ev.preventDefault(); // parent (Styles/Services/Events) never navigates , only opens the submenu
            if(window.matchMedia('(max-width:960px)').matches){
              var wasOpen=hs.classList.contains('open');
              document.querySelectorAll('.has-sub.open').forEach(function(o){ if(o!==hs) o.classList.remove('open'); });
              hs.classList.toggle('open', !wasOpen);
            }
          }); }
        });
        // Do NOT close the menu on the link's click event , on touch the closing slide
        // moves the tap target and cancels navigation. Let page links navigate (fresh
        // page loads with menu closed); same-page hash links close via hashchange.
        addEventListener('hashchange', closeMenu);
        addEventListener('keydown',function(e){ if(e.key==='Escape') closeMenu(); });
      }catch(e){}
      // reveal on scroll
      try{
        var io=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); },{threshold:.12});
        document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
      }catch(e){ document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('in'); }); }
      // countdown(s)
      try{
        var cds=document.querySelectorAll('.countdown[data-deadline]');
        if(cds.length){
          var pad=function(n){ return String(n).padStart(2,'0'); };
          var tick=function(){
            cds.forEach(function(cd){
              var dl=cd.getAttribute('data-deadline');
              var d=dl?new Date(dl).getTime():0;
              var diff=d?Math.max(0,d-Date.now()):0;
              var s=Math.floor(diff/1000);
              var days=Math.floor(s/86400), hrs=Math.floor((s%86400)/3600), mins=Math.floor((s%3600)/60), secs=s%60;
              var set=function(sel,v){ var el=cd.querySelector(sel); if(el) el.textContent=pad(v); };
              set('.cd-d',days); set('.cd-h',hrs); set('.cd-m',mins); set('.cd-s',secs);
            });
          };
          tick(); setInterval(tick,1000);
        }
      }catch(e){}
      // newsletter success message
      try{
        if(location.search.indexOf('subscribed')>-1){ var sm=document.querySelector('.newsletter .sent'); if(sm) sm.hidden=false; }
      }catch(e){}
      // single-open accordion (only one tab open at a time)
      try{
        document.querySelectorAll('.acc-single details').forEach(function(d){
          d.addEventListener('toggle',function(){
            if(d.open){ d.parentElement.querySelectorAll('details[open]').forEach(function(o){ if(o!==d) o.open=false; }); }
          });
        });
      }catch(e){}
      // vertical tabs (e.g. past events)
      try{
        document.querySelectorAll('.pe-tabs').forEach(function(group){
          var tabs=group.querySelectorAll('.pe-tab');
          var panels=group.querySelectorAll('.pe-panel');
          tabs.forEach(function(tab){
            tab.addEventListener('click',function(){
              var i=tab.getAttribute('data-i');
              tabs.forEach(function(t){ t.classList.toggle('active',t===tab); });
              panels.forEach(function(p){ p.hidden = p.getAttribute('data-i')!==i; });
              if(window.matchMedia('(max-width:860px)').matches){ var pp=group.querySelector('.pe-panels'); if(pp) pp.scrollIntoView({behavior:'smooth',block:'start'}); }
            });
          });
        });
      }catch(e){}
      // lightbox
      try{
        var lb=document.getElementById('lb'),lbimg=document.getElementById('lbimg'),lbx=document.getElementById('lbx');
        document.querySelectorAll('[data-lb]').forEach(function(el){ el.addEventListener('click',function(e){ e.preventDefault(); lbimg.src=el.getAttribute('data-lb'); lb.classList.add('on'); }); });
        var closeLb=function(){ lb.classList.remove('on'); lbimg.src=''; };
        if(lbx) lbx.addEventListener('click',closeLb);
        if(lb) lb.addEventListener('click',function(e){ if(e.target===lb) closeLb(); });
        addEventListener('keydown',function(e){ if(e.key==='Escape') closeLb(); });
      }catch(e){}
    })();
  </script>
</body>
</html>
