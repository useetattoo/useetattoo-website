---
import Base from '../../layouts/Base.astro';
import { langs, t } from '../../data/i18n.js';
import { site } from '../../data/site.js';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const L = t[lang];

const c = {
  de: {
    title: 'Über Usee Tattoo | Tattoo Studio Berlin-Charlottenburg',
    description: 'Usee Tattoo: Custom Tattoo Studio in Berlin-Charlottenburg. Ein festes Team aus acht Artists, 2020 von Josef Jamdar gegründet. Kunst, die sichtbar wird.',
    eyebrow: 'Über Usee',
    h1: 'Ein Studio, das<br>Kunst sichtbar macht',
    lead: 'Usee Tattoo ist Berlins Custom Tattoo Studio in Charlottenburg, ein festes Team aus Artists, die Tätowieren als Kunst verstehen. Jedes Motiv entsteht individuell, in persönlicher Beratung.',
    studioEyebrow: 'Das Studio',
    studioBody: [
      'Usee Tattoo ist ein Custom Tattoo Studio im Herzen von Berlin-Charlottenburg. Seit 2020 steht hier ein klarer Anspruch im Mittelpunkt: Tätowieren als ernsthafte Kunstform zu behandeln und jedem Motiv den Raum zu geben, den es verdient.',
      'Heute arbeiten acht feste Artists unter einem Dach, ergänzt durch wechselnde Gast-Artists aus aller Welt und unsere Piercing-Spezialistin Nana. Vom fotorealistischen Schwarz-Grau über Fine Line, Ornamental, Maori und Japanese bis zu Lettering und Cover-ups deckt das Team ein breites Spektrum ab, jedes Stück individuell und nach persönlicher Beratung.',
      `Usee Tattoo ist zugleich ein Artspace: ein Ort für Kultur, Events und Gast-Residencies, an dem Kunst nicht nur entsteht, sondern sichtbar wird. Sterile Einwegnadeln, deutsche Qualitätsstandards und ${site.reviews.count} Google-Bewertungen mit ${site.reviews.rating.de} Sternen stehen für die Sorgfalt hinter jedem Termin.`,
    ],
    founderEyebrow: 'Der Gründer',
    founderBody: [
      'Gegründet wurde Usee Tattoo von Josef Jamdar, geboren 1990 in Teheran. Schon früh war seine Leidenschaft für Design und Kunst unübersehbar, und mit 18 trat er in die Welt des Tätowierens ein.',
      'Getrieben von unermüdlicher Hingabe reiste Josef nach Istanbul, um bei einigen der angesehensten Meister des Fachs zu lernen. 2015 zog er nach Deutschland, startete unabhängig in Dessau und eröffnete 2020 sein erstes eigenes Studio in der Neue Kantstraße 6.',
      'Seine Handschrift ist der Realismus in Schwarz-Grau, von Tierporträts über Gesichter bis zu großflächigen Sleeves. Bis heute prägt Josef die künstlerische Linie des Studios, mit einem klaren Ziel: eine Bühne für Artists, deren Talent zu oft ungesehen bleibt. Denn Kunst verdient es, gesehen zu werden.',
    ],
    stats: [['2020', 'Gegründet'], [site.reviews.count, site.reviews.rating.de + '★ ' + site.reviews.de], ['Artspace', 'Kultur & Events'], ['Berlin', 'Charlottenburg']],
    whyEyebrow: 'Warum Usee',
    whyTitle: 'Ein Tattoo Studio in Charlottenburg,<br>das seinen Anspruch hält',
    whyItems: [
      ['Erfahrene Artists', 'Jedes Tattoo bei uns wird von einem erfahrenen Resident-Artist gestochen, nie von einem Lehrling in Ausbildung.'],
      ['Entwurf vor der Nadel', 'Kein Motiv aus dem Katalog. Gespräch, Entwurf, Änderungen, dann der Termin. Der Preis steht fest, bevor die erste Linie deine Haut berührt.'],
      ['Höchste Hygienestandards', 'Sterile Einwegnadeln und deutsche Qualitätsstandards bei Farben und Ausrüstung, bei jedem Termin.'],
      ['Zentral in Charlottenburg', `${site.address.street}, mitten in Charlottenburg, gut erreichbar aus der ganzen Stadt. ${L.hours}.`],
    ],
    servicesTitle: 'Unsere Leistungen',
    services: [
      ['Persönliche Beratung', '/de/consultation/'],
      ['Walk-In Tattoo', '/de/walk-in/'],
      ['Piercing', '/de/piercing/'],
      ['Cover-Up', '/de/cover-up/'],
    ],
    quote: 'Ich habe mich mit 53 Jahren dazu entschieden, mir mein erstes Tattoo stechen zu lassen, und bin sowas von begeistert.',
    quoteSrc: 'Google-Bewertung · Usee Tattoo Studio',
    visitTitle: 'Besuch uns in Charlottenburg',
  },
  en: {
    title: 'About Usee Tattoo | Tattoo Studio Berlin-Charlottenburg',
    description: 'Usee Tattoo: a custom tattoo studio in Berlin-Charlottenburg. A settled team of eight artists, founded in 2020 by Josef Jamdar. Art made to be seen.',
    eyebrow: 'About Usee',
    h1: 'A studio built<br>to make art seen',
    lead: "Usee Tattoo is Berlin's custom tattoo studio in Charlottenburg, a settled team of artists who treat tattooing as art. Every piece is created individually, through personal consultation.",
    studioEyebrow: 'The Studio',
    studioBody: [
      'Usee Tattoo is a custom tattoo studio in the heart of Berlin-Charlottenburg. Since 2020 one standard has sat at its core: to treat tattooing as a serious art form and give every piece the space it deserves.',
      'Today eight resident artists work under one roof, joined by visiting guest artists from around the world and our piercing specialist, Nana. From photorealistic black & grey to fine line, ornamental, Maori and Japanese, through to lettering and cover-ups, the team covers a wide range, every piece individual and created after a personal consultation.',
      `Usee Tattoo is also an artspace: a place for culture, events and guest residencies, where art is not only made but made visible. Sterile single-use needles, German quality standards and ${site.reviews.count} Google reviews at ${site.reviews.rating.en} stars speak for the care behind every appointment.`,
    ],
    founderEyebrow: 'The Founder',
    founderBody: [
      'Usee Tattoo was founded by Josef Jamdar, born in Tehran in 1990. His passion for design and art was undeniable from an early age, and at eighteen he entered the world of tattooing.',
      "Driven by relentless dedication, Josef travelled to Istanbul to learn from some of the field's most respected masters. In 2015 he moved to Germany, started independently in Dessau, and in 2020 opened his first own studio on Neue Kantstraße 6.",
      "His signature is realism in black & grey, from animal portraits to faces to large-scale sleeves. To this day Josef shapes the studio's artistic direction, with one clear aim: a stage for artists whose talent too often goes unseen. Because art deserves to be seen.",
    ],
    stats: [['2020', 'Founded'], [site.reviews.count, site.reviews.rating.en + '★ ' + site.reviews.en], ['Artspace', 'Culture & events'], ['Berlin', 'Charlottenburg']],
    whyEyebrow: 'Why Usee',
    whyTitle: 'A tattoo studio in Charlottenburg<br>that holds its standard',
    whyItems: [
      ['Experienced artists', 'Every tattoo here is done by an experienced resident artist, never an apprentice in training.'],
      ['Individual design', 'No motif from a catalogue. Every piece is designed for your body, your anatomy and your story, through personal consultation.'],
      ['Highest hygiene standards', 'Sterile single-use needles and German quality standards for inks and equipment, at every appointment.'],
      ['Central in Charlottenburg', `${site.address.street}, right in the heart of Charlottenburg, easy to reach from across the city. ${L.hours}.`],
    ],
    servicesTitle: 'Our Services',
    services: [
      ['Personal consultation', '/en/consultation/'],
      ['Walk-in tattoo', '/en/walk-in/'],
      ['Piercing', '/en/piercing/'],
      ['Cover-up', '/en/cover-up/'],
    ],
    quote: "At 53, I decided to get my first tattoo, and I'm absolutely thrilled with it.",
    quoteSrc: 'Google review · Usee Tattoo Studio',
    visitTitle: 'Visit us in Charlottenburg',
  },
}[lang];
---
<Base lang={lang} title={c.title} description={c.description} ogImage="/images/AboutUsee/UseeTattoo.webp">
  <section class="detail-hero">
    <div class="wrap">
      <div class="dh-txt reveal" style="max-width:820px">
        <div class="eyebrow">{c.eyebrow}</div>
        <h1 set:html={c.h1}></h1>
        <p class="bio" style="max-width:640px;font-size:19px">{c.lead}</p>
      </div>
    </div>
  </section>

  <section style="padding-top:20px">
    <div class="wrap">
      <div class="about-media reveal"><img src="/images/AboutUsee/UseeTattoo.webp" alt="Usee Tattoo Studio" /></div>
      <div class="about-split reveal">
        <div class="about-col">
          <div class="eyebrow">{c.studioEyebrow}</div>
          {c.studioBody.map((p) => <p>{p}</p>)}
        </div>
        <div class="about-col">
          <div class="eyebrow">{c.founderEyebrow}</div>
          {c.founderBody.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="about-stats reveal">
        {c.stats.map(([n, l]) => (
          <div class="stat"><div class="num">{n}</div><div class="lbl">{l}</div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="why-section">
    <div class="wrap">
      <div class="reveal" style="max-width:720px">
        <div class="eyebrow">{c.whyEyebrow}</div>
        <h2 class="why-h2" set:html={c.whyTitle}></h2>
      </div>
      <div class="why-grid reveal">
        {c.whyItems.map(([title, text]) => (
          <div class="why-card">
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>

      <div class="quote-block reveal">
        <p class="quote-text">&ldquo;{c.quote}&rdquo;</p>
        <p class="quote-src">{c.quoteSrc}</p>
      </div>

      <div class="services-visit reveal">
        <div class="services-col">
          <h3>{c.servicesTitle}</h3>
          <ul>
            {c.services.map(([label, href]) => (
              <li><a href={href}>{label} →</a></li>
            ))}
          </ul>
        </div>
        <div class="visit-col">
          <h3>{c.visitTitle}</h3>
          <p>{site.address.street}, {site.address.zip} {site.address.city}</p>
          <p>{L.hours}</p>
          <p><a href={site.phone.href}>{site.phone.display}</a></p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .about-media{aspect-ratio:16/8;overflow:hidden;background:#e3ddd1;filter:grayscale(1) contrast(1.02);margin-bottom:64px}
    .about-media img{width:100%;height:100%;object-fit:cover}
    .about-split{display:grid;grid-template-columns:1fr 1fr;gap:64px;max-width:980px}
    .about-col .eyebrow{margin-bottom:16px}
    .about-col p{margin:0 0 20px;color:var(--ink-soft);font-size:16px;line-height:1.85}
    .about-col p:last-child{margin-bottom:0}
    .about-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:80px}
    .about-stats .stat{background:var(--paper);padding:44px 30px;text-align:center}
    .about-stats .num{font-family:'Cormorant Garamond',serif;font-size:46px;color:var(--bronze-dk)}
    .about-stats .lbl{font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);margin-top:8px}
    @media(max-width:760px){.about-split{grid-template-columns:1fr;gap:40px}.about-stats{grid-template-columns:repeat(2,1fr)}}

    .why-section{padding:100px 0}
    .why-h2{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(30px,4vw,42px);line-height:1.15;margin:12px 0 0}
    .why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:48px}
    .why-card{background:var(--paper);padding:32px 26px}
    .why-card h3{font-family:'Inter',sans-serif;font-size:14px;letter-spacing:.02em;color:var(--ink);margin:0 0 10px}
    .why-card p{font-family:'Inter',sans-serif;font-size:14.5px;line-height:1.7;color:var(--ink-soft);margin:0}
    @media(max-width:900px){.why-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:560px){.why-grid{grid-template-columns:1fr}}

    .quote-block{max-width:720px;margin:72px auto 0;text-align:center}
    .quote-text{font-family:'Cormorant Garamond',serif;font-size:clamp(22px,3vw,30px);line-height:1.4;color:var(--ink);margin:0 0 14px}
    .quote-src{font-family:'Inter',sans-serif;font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft)}

    .services-visit{display:grid;grid-template-columns:1fr 1fr;gap:56px;margin-top:80px;max-width:900px}
    .services-visit h3{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:24px;color:var(--ink);margin:0 0 18px}
    .services-col ul{list-style:none;margin:0;padding:0}
    .services-col li{border-top:1px solid var(--line);padding:14px 0}
    .services-col li:last-child{border-bottom:1px solid var(--line)}
    .services-col a{font-family:'Inter',sans-serif;font-size:15px;color:var(--ink);text-decoration:none}
    .services-col a:hover{color:var(--bronze-dk)}
    .visit-col p{font-family:'Inter',sans-serif;font-size:15px;line-height:1.8;color:var(--ink-soft);margin:0 0 8px}
    .visit-col a{color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px}
    @media(max-width:700px){.services-visit{grid-template-columns:1fr;gap:40px}}
  </style>
</Base>
