---
import Base from '../../../layouts/Base.astro';
import { t, langs } from '../../../data/i18n.js';
import { site } from '../../../data/site.js';
import { artists } from '../../../data/artists.js';
import { gallery } from '../../../lib/gallery.js';

export function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const a of artists.filter((x) => x.built)) {
      paths.push({ params: { lang, slug: a.slug }, props: { artist: a } });
    }
  }
  return paths;
}
const { lang } = Astro.params;
const { artist } = Astro.props;
const L = t[lang];
const base = `/${lang}`;
const imgs = gallery(`/images/portfolio/${artist.folder}`, { exclude: ['Profile', 'Highlight'] });

const title = lang === 'de'
  ? `${artist.name}, Tattoo Artist | UseeTattoo Studio Berlin`
  : `Tattoo Artist ${artist.name} | UseeTattoo Studio Berlin`;
const description = artist.meta[lang];
const bio = artist.bio[lang];
const firstWorks = artist.firstWorks; // mobile-only first screen (Josef), see artists.js

// Person schema. Until now nothing on the site said, in a machine-readable way,
// that a given artist works here and which styles they actually do, so search
// engines and AI assistants had no way to answer "who does realism in Berlin".
// knowsAbout is derived from the same specialties string the page already renders,
// so the schema and the visible text can never drift apart.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.domain}/${lang}/artists/${artist.slug}/#person`,
  name: artist.name,
  url: `${site.domain}/${lang}/artists/${artist.slug}/`,
  image: `${site.domain}${artist.portrait}`,
  description: artist.meta[lang],
  jobTitle: artist.piercing
    ? (lang === 'de' ? 'Piercing-Spezialistin' : 'Piercing Specialist')
    : (lang === 'de' ? 'Tattoo-Künstler' : 'Tattoo Artist'),
  knowsAbout: artist.specialties[lang].split('·').map((s) => s.trim()).filter(Boolean),
  worksFor: { '@id': `${site.domain}/#business` },
  workLocation: { '@id': `${site.domain}/#business` },
};

// BreadcrumbList (ND-245). There is no /artists/ index page, so the middle crumb
// points at the homepage #artists section, the same target the site nav uses.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Usee Tattoo', item: `${site.domain}/${lang}/` },
    { '@type': 'ListItem', position: 2, name: L.nav.artists, item: `${site.domain}/${lang}/#artists` },
    { '@type': 'ListItem', position: 3, name: artist.name, item: `${site.domain}/${lang}/artists/${artist.slug}/` },
  ],
};
---
<Base lang={lang} title={title} description={description} ogImage={artist.portrait} noLoader={!!firstWorks}>
  <section class={firstWorks ? 'detail-hero dh-first' : 'detail-hero'}>
    <div class="wrap dh-grid">
      <div class="portrait reveal"><img src={artist.portrait} alt={artist.name} /></div>
      <div class="dh-txt reveal">
        <div class="eyebrow">{L.nav.artists}</div>
        <h1>{artist.name}</h1>
        <div class="spec">{artist.specialties[lang]}</div>
        {firstWorks && (
          <div class="dh-mfirst">
            <div class="dh-works">
              {firstWorks.map((w, i) => (
                <a data-lb={w.full}><img src={w.src} alt={w.alt[lang]} width="400" height="500" loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" /></a>
              ))}
            </div>
            <a class="cta primary dh-mbook" id="dhMBook" href={artist.book} target="_blank" rel="noopener">{L.bookConsult}</a>
          </div>
        )}
        {bio
          ? <p class="bio">{bio}</p>
          : <p class="bio placeholder">{lang === 'de' ? 'Biografie folgt in Kürze.' : 'Biography coming soon.'}</p>}
        <div class="cta-row" style="margin-top:0">
          <a class="cta primary" style="background:var(--ink);color:var(--paper)" href={artist.book} target="_blank" rel="noopener">{L.bookConsult}</a>
        </div>
        {['josef', 'cali', 'jvd'].includes(artist.slug) && (
          <p style="margin-top:12px;font-size:14px"><a href={`/${lang}/consultation/#ablauf-section`} style="color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px">&#9432; {L.ablaufCta}</a></p>
        )}
          <p style="margin-top:14px;font-size:14.5px"><a href="#quick-form" style="display:inline-block;border:1px solid var(--ink);padding:11px 20px;margin-right:4px;color:var(--ink);font-weight:600;text-decoration:none;letter-spacing:.04em">{L.jumpForm}</a> · <a href={site.whatsapp} target="_blank" rel="noopener" style="color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px">{L.whatsappCta}</a></p>
      </div>
    </div>
  </section>

  {imgs.length > 0 && (
    <section class="pf">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="idx">{L.portfolio}</span>
          <h2>{artist.name}</h2>
          <a href={artist.book} target="_blank" rel="noopener">{L.bookConsult}→</a>
        </div>
        <div class="pf-masonry reveal">
          {imgs.map((src) => (
            <a data-lb={src}><img src={src} alt={`${artist.name}, Usee Tattoo`} loading="lazy" /></a>
          ))}
        </div>
      </div>
    </section>
  )}

  {firstWorks && (
    <>
      <a class="dh-sticky" id="dhSticky" href={artist.book} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">{L.bookConsult}</a>
      <style is:global>
        /* Josef mobile first screen (2026-11-11). Desktop (>960px) is untouched:
           the block and the sticky button only exist below the 960px breakpoint. */
        .dh-mfirst,.dh-sticky{display:none}
        @media(max-width:960px){
          .dh-first{padding-top:84px}
          .dh-first .dh-grid{gap:32px}
          .dh-first .dh-txt{order:1}
          .dh-first .portrait{order:2}
          .dh-first .dh-txt.reveal,.dh-first .portrait.reveal{opacity:1;transform:none}
          .dh-first .dh-txt .eyebrow{margin-bottom:10px}
          .dh-first .dh-txt h1{margin-bottom:8px}
          .dh-first .dh-txt .spec{margin-bottom:16px}
          .dh-mfirst{display:block;margin-bottom:28px}
          .dh-works{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
          .dh-works a{display:block;cursor:zoom-in;background:#e3ddd1}
          .dh-works img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover}
          .dh-mfirst .cta.dh-mbook{display:block;width:100%;text-align:center;margin-top:14px;background:var(--ink);color:var(--paper)}
          .dh-sticky{display:block;position:fixed;left:14px;right:76px;bottom:14px;z-index:79;height:48px;line-height:48px;text-align:center;
            background:var(--ink);color:var(--paper);font-family:'Inter',sans-serif;font-size:12.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
            text-decoration:none;box-shadow:0 6px 24px rgba(0,0,0,.25);transform:translateY(160%);transition:transform .35s cubic-bezier(.22,1,.36,1)}
          .dh-sticky.on{transform:none}
        }
      </style>
      <script is:inline>
        (function(){
          // Sticky "Beratung buchen" on phones: only once the in-page button has
          // scrolled out of view, and never while the cookie banner is open (it
          // would sit on top of the banner's buttons). Left of the call/WhatsApp
          // buttons (right:76px), so it never covers them either.
          try{
            var st=document.getElementById('dhSticky'),btn=document.getElementById('dhMBook'),ck=document.getElementById('cookieBanner');
            if(!st||!btn) return;
            var past=false;
            var upd=function(){ var on=past&&!(ck&&!ck.hidden); st.classList.toggle('on',on); st.setAttribute('aria-hidden',on?'false':'true'); st.tabIndex=on?0:-1; };
            new IntersectionObserver(function(es){ es.forEach(function(e){ past=!e.isIntersecting&&e.boundingClientRect.top<0; upd(); }); }).observe(btn);
            if(ck) new MutationObserver(upd).observe(ck,{attributes:true,attributeFilter:['hidden']});
          }catch(e){}
        })();
      </script>
    </>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>
