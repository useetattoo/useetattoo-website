---
import Base from '../../../layouts/Base.astro';
import { t, langs } from '../../../data/i18n.js';
import { site } from '../../../data/site.js';
import { artists } from '../../../data/artists.js';
import { gallery } from '../../../lib/gallery.js';
import FirstWorks from '../../../components/FirstWorks.astro';
import firstWorksData from '../../../data/firstWorks.json';

export function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const a of artists.filter((x) => x.built)) {
      paths.push({ params: { lang, slug: a.slug }, props: { artist: a } });
    }
  }
  return paths;
}
const { lang } = Astro.params;
const { artist } = Astro.props;
const L = t[lang];
const base = `/${lang}`;
const imgs = gallery(`/images/portfolio/${artist.folder}`, { exclude: ['Profile', 'Highlight'] });
// Newly added work (AAA_ prefix) is shown first, in its own block at the very top,
// so it sits above the older pieces instead of scattering down the masonry columns.
const freshImgs = imgs.filter((s) => /AAA_/.test(s));
const restImgs = imgs.filter((s) => !/AAA_/.test(s));

const title = lang === 'de'
  ? `${artist.name}, Tattoo Artist | UseeTattoo Studio Berlin`
  : `Tattoo Artist ${artist.name} | UseeTattoo Studio Berlin`;
const description = artist.meta[lang];
const bio = artist.bio[lang];
// Mobile-only first screen (ND-482): Josef's hand-picked list (artists.js), every other
// artist gets the first 6 works of the page (scripts/gen-first-works.mjs).
const firstWorks = (artist.firstWorks
  ? artist.firstWorks.map((w) => ({ src: w.src, full: w.full, alt: w.alt[lang] }))
  : (firstWorksData[`artist-${artist.slug}`] || []).map((w) => ({ ...w, alt: `${artist.name}, Usee Tattoo` })));
const hasFirst = firstWorks.length > 0;
const book = artist.pageBook || artist.book; // ND-432: Josef -> Fresha with Josef pre-selected
const toForm = !!artist.toForm; // ND-485: buttons -> #quick-form on this page
const mHref = toForm ? '#quick-form' : book;
const mLabel = toForm ? L.sendIdeaPhoto : L.bookConsult;
// ND-482: ids carry booking-fresha-cta only where the button really goes to Fresha.
const mId = toForm ? undefined : `booking-fresha-cta-${artist.slug}`;
const consult = artist.consult?.[lang]; // ND-432 consultation block (DE only)
// ND-442: GTM trigger "Click - Booking Fresha CTA" = Just Links, Click ID contains
// booking-fresha-cta. Josef's booking links get a unique id carrying that string
// (ids must be unique per page); other artists unchanged.
const ctaId = (k) => (artist.slug === 'josef' ? `booking-fresha-cta-josef-${k}` : undefined);

// Person schema. Until now nothing on the site said, in a machine-readable way,
// that a given artist works here and which styles they actually do, so search
// engines and AI assistants had no way to answer "who does realism in Berlin".
// knowsAbout is derived from the same specialties string the page already renders,
// so the schema and the visible text can never drift apart.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.domain}/${lang}/artists/${artist.slug}/#person`,
  name: artist.name,
  url: `${site.domain}/${lang}/artists/${artist.slug}/`,
  image: `${site.domain}${artist.portrait}`,
  description: artist.meta[lang],
  jobTitle: artist.piercing
    ? (lang === 'de' ? 'Piercing-Spezialistin' : 'Piercing Specialist')
    : (lang === 'de' ? 'Tattoo-Künstler' : 'Tattoo Artist'),
  knowsAbout: artist.specialties[lang].split('·').map((s) => s.trim()).filter(Boolean),
  worksFor: { '@id': `${site.domain}/#business` },
  workLocation: { '@id': `${site.domain}/#business` },
};

// BreadcrumbList (ND-245). There is no /artists/ index page, so the middle crumb
// points at the homepage #artists section, the same target the site nav uses.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Usee Tattoo', item: `${site.domain}/${lang}/` },
    { '@type': 'ListItem', position: 2, name: L.nav.artists, item: `${site.domain}/${lang}/#artists` },
    { '@type': 'ListItem', position: 3, name: artist.name, item: `${site.domain}/${lang}/artists/${artist.slug}/` },
  ],
};
---
<Base lang={lang} title={title} description={description} ogImage={artist.portrait} noLoader={hasFirst}>
  <section class={hasFirst ? 'detail-hero dh-first' : 'detail-hero'}>
    <div class="wrap dh-grid">
      <div class="portrait reveal"><img src={artist.portrait} alt={artist.name} /></div>
      <div class="dh-txt reveal">
        <div class="eyebrow">{L.nav.artists}</div>
        <h1>{artist.name}</h1>
        <div class="spec">{artist.specialties[lang]}</div>
        {hasFirst && <FirstWorks works={firstWorks} href={mHref} label={mLabel} id={mId} />}
        {consult && (
          <div class="dh-consult" id="beratung">
            <h2>{consult.h}</h2>
            <p class="dh-consult-intro">{consult.intro}</p>
            <ul>{consult.lines.map((x) => <li>{x}</li>)}</ul>
            <div class="dh-consult-cta">
              <a class="cta primary" style="background:var(--ink);color:var(--paper)" href="#quick-form">{consult.cta}</a>
              <a class="dh-consult-wa" href={site.whatsapp} target="_blank" rel="noopener">{L.whatsappCta}</a>
            </div>
          </div>
        )}
        {bio
          ? <p class="bio">{bio}</p>
          : <p class="bio placeholder">{lang === 'de' ? 'Biografie folgt in Kürze.' : 'Biography coming soon.'}</p>}
        <div class="cta-row" style="margin-top:0">
          {toForm
            ? <a class="cta primary" style="background:var(--ink);color:var(--paper)" href="#quick-form">{L.sendIdeaPhoto}</a>
            : <a class="cta primary" id={ctaId('bio')} style="background:var(--ink);color:var(--paper)" href={book} target="_blank" rel="noopener">{L.bookConsult}</a>}
        </div>
        {toForm && <p style="margin-top:12px;font-size:14px">{L.sendIdeaNote}</p>}
        {!toForm && ['josef', 'cali', 'jvd'].includes(artist.slug) && (
          <p style="margin-top:12px;font-size:14px"><a href={`/${lang}/consultation/#ablauf-section`} style="color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px">&#9432; {L.ablaufCta}</a></p>
        )}
          <p style="margin-top:14px;font-size:14.5px">{!toForm && <><a href="#quick-form" style="display:inline-block;border:1px solid var(--ink);padding:11px 20px;margin-right:4px;color:var(--ink);font-weight:600;text-decoration:none;letter-spacing:.04em">{L.jumpForm}</a> · </>}<a href={site.whatsapp} target="_blank" rel="noopener" style="color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px">{L.whatsappCta}</a></p>
      </div>
    </div>
  </section>

  {imgs.length > 0 && (
    <section class="pf">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="idx">{L.portfolio}</span>
          <h2>{artist.name}</h2>
          {toForm
            ? <a href="#quick-form">{L.sendIdea} →</a>
            : <a id={ctaId('portfolio')} href={book} target="_blank" rel="noopener">{L.bookConsult}→</a>}
        </div>
        {freshImgs.length > 0 && (
          <div class="pf-fresh reveal" style={`--fresh-cols:${Math.min(freshImgs.length, 5)}`}>
            {freshImgs.map((src) => (
              <a data-lb={src}><img src={src} alt={`${artist.name}, Usee Tattoo`} loading="lazy" /></a>
            ))}
          </div>
        )}
        <div class="pf-masonry reveal">
          {restImgs.map((src) => (
            <a data-lb={src}><img src={src} alt={`${artist.name}, Usee Tattoo`} loading="lazy" /></a>
          ))}
        </div>
      </div>
    </section>
  )}

  {hasFirst && <FirstWorks part="sticky" href={mHref} label={mLabel} id={mId} />}

  {consult && (
    <style>
      .dh-consult{border:1px solid var(--line);background:var(--paper);padding:26px 24px;margin:0 0 30px}
      .dh-consult h2{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(24px,3vw,30px);line-height:1.2;margin:0 0 10px}
      .dh-consult-intro{color:var(--ink);font-weight:600;font-size:15.5px;margin:0 0 14px}
      .dh-consult ul{list-style:none;margin:0 0 20px;padding:0}
      .dh-consult li{position:relative;padding:8px 0 8px 22px;color:var(--ink-soft);font-size:15px;line-height:1.6;border-bottom:1px solid rgba(216,210,198,.55)}
      .dh-consult li:last-child{border-bottom:0}
      .dh-consult li::before{content:'✓';position:absolute;left:0;top:8px;color:var(--bronze);font-weight:600}
      .dh-consult-cta{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px}
      .dh-consult-wa{color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px;font-size:14.5px}
      @media(max-width:560px){.dh-consult{padding:22px 18px}.dh-consult-cta .cta{width:100%;text-align:center}}
    </style>
  )}
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>
