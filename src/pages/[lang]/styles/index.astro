---
// ND-277 / ND-381 styles hub, DE + EN.
// ND-381 (niloo 2026-11-11): the style section with covers exactly like the homepage
// (same .style-grid tiles, same photos, same order), a short SEO text on top, each tile
// opens its style page. Homepage itself is NOT touched (niloo 2026-10-28).
// DE texts: approved draft (SEO Content 2026-10-24) verbatim. No artist names, no Dotwork (ND-278).
// EN texts: PREVIEW translation of the approved DE text, pending SEO Content / niloo sign-off.
// Schema (CollectionPage/BreadcrumbList) is a separate, later approval.
import Base from '../../../layouts/Base.astro';
import { langs } from '../../../data/i18n.js';
import { site } from '../../../data/site.js';
import { styles } from '../../../data/styles.js';
import { gallery } from '../../../lib/gallery.js';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const base = `/${lang}`;

// Same cover logic as the homepage style grid (src/pages/[lang]/index.astro), so the
// hub shows exactly the homepage photos.
const heroForHome = new Set(['ornamental', 'dotwork', 'maori', 'fine-line', 'black-and-grey', 'conceptual', 'japanese', 'lettering']);
const styleImg = Object.fromEntries(
  styles.map((s) => {
    if (heroForHome.has(s.slug) && s.hero) return [s.slug, `/images/TattooStyle/${s.folder}/${s.hero}`];
    return [s.slug, gallery(`/images/TattooStyle/${s.folder}`, { exclude: ['Highlight'] })[0] || site.heroImage];
  })
);
const tiles = styles.filter((s) => s.built);

const T = {
  de: {
    title: 'Tattoo-Stile in Berlin: Welcher Stil trägt dein Motiv?',
    description: 'Elf Tattoo-Stile in Berlin-Charlottenburg, von Realistic bis Schriftzug. Wir klären zuerst, welcher Stil dein Motiv trägt. 4,9 ★ aus 700+ Bewertungen.',
    h1: 'Tattoo-Stile in Berlin',
    intro: 'Ein Motiv im falschen Stil gesetzt altert falsch, nicht am ersten Tag, sondern nach Jahren. Deshalb wird bei uns zuerst geklärt, welcher Stil dein Motiv trägt, und danach, wer ihn im Studio arbeitet. Hier siehst du, was jeder der elf Stile technisch verlangt.',
    outro: 'Du weißt nicht, welcher Stil passt? Das klärt die Beratung. Entwurf und Festpreis stehen fest, bevor ein Termin vergeben wird.',
    cta: 'Beratung',
  },
  en: {
    title: 'Tattoo Styles in Berlin: Which Style Carries Your Design?',
    description: 'Eleven tattoo styles in Berlin-Charlottenburg, from Realistic to Lettering. First we work out which style carries your design. 4.9 ★ from 700+ reviews.',
    h1: 'Tattoo Styles in Berlin',
    intro: 'A design set in the wrong style ages the wrong way, not on day one, but years later. That is why we first work out which style carries your design, and only then who in the studio works it. Here you can see what each of the eleven styles demands technically.',
    outro: 'Not sure which style fits? The consultation settles that. Design and fixed price are set before an appointment is booked.',
    cta: 'Consultation',
  },
}[lang];

// Approved DE one-liners per style (SEO Content 2026-10-24): what each style demands technically.
// Shown as a linked list under the grid (too long for the tiles on mobile). Tiles carry the
// same tagline as the homepage. No approved EN version of these lines yet, so EN has no list.
const lineDe = {
  'realistic': 'Licht und Schatten werden in mehreren Nadelgängen aufgebaut, damit das Motiv nach Jahren räumlich bleibt.',
  'microrealism': 'Reduzierte Nadeltiefe, damit kleine Details nicht zu einer grauen Fläche verschwimmen.',
  'fine-line': 'Gleichmäßiger Nadeldruck, und die Linie wird nach vollständiger Abheilung geprüft; Nachstechen gehört zum Ablauf.',
  'black-and-grey': 'Dunkle Kernbereiche zuerst, weiche Übergänge danach, damit Kontraste scharf bleiben.',
  'portraits': 'Die Proportionen der Vorlage werden ausgemessen, bevor das Stencil entsteht.',
  'maori': 'Tā-Moko-Muster werden freihand auf die Haut gezeichnet, weil Linien auf Papier an jeder Rundung auseinanderlaufen.',
  'japanese': 'Die gesamte Fläche wird festgelegt, bevor die erste Sitzung beginnt.',
  'ornamental': 'Die Mittelachse wird auf der Haut gesucht, nicht angenommen.',
  'color': 'Im Entwurf steht zuerst, was das Motiv trägt, wenn die hellsten Töne nachlassen.',
  'conceptual': 'Mehrere Elemente, die sich als eine einzige Geschichte lesen.',
  'lettering': 'Erst wird die Textlänge gegen die Körperstelle gerechnet, dann die Schriftart.',
};
---
<Base lang={lang} title={T.title} description={T.description}>
<section class="detail-hero">
<div class="wrap">
<div class="txt dh-txt reveal">
<h1>{T.h1}</h1>
<p>{T.intro}</p>
</div>
</div>
</section>
<section id="styles" style="padding-top:30px">
<div class="wrap">
<div class="style-grid reveal">
{tiles.map((s, i) => (
<a class="style-tile" href={`${base}/styles/${s.slug}/`}>
<img class="style-img" src={styleImg[s.slug]} alt={s.name[lang]} loading={i < 4 ? 'eager' : 'lazy'} />
<div class="curtain c-l"></div>
<div class="curtain c-r"></div>
<div class="style-label">
<span class="n">{String(i + 1).padStart(2, '0')}</span>
<h2 style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:26px;color:var(--paper);margin-top:4px">{s.name[lang]}</h2>
<p class="style-desc">{s.tagline[lang]}</p>
</div>
</a>
))}
</div>
</div>
</section>
{lang === 'de' && (
<section style="padding:40px 0 0">
<div class="wrap reveal">
<ul style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px 32px">
{tiles.filter((s) => lineDe[s.slug]).map((s) => (
<li style="font-size:14px;line-height:1.6"><a href={`${base}/styles/${s.slug}/`} style="font-weight:500">{s.name[lang]}</a>: {lineDe[s.slug]}</li>
))}
</ul>
</div>
</section>
)}
<section style="padding:40px 0 80px">
<div class="wrap reveal">
<p>{T.outro}</p>
<p style="margin-top:24px"><a class="cta primary" style="background:var(--ink);color:var(--paper)" href={`${base}/consultation/`}>{T.cta}</a></p>
</div>
</section>
</Base>
