---
import Base from '../../../layouts/Base.astro';
import { t, langs } from '../../../data/i18n.js';
import { styles, stylesBySlug } from '../../../data/styles.js';
import { artistsBySlug } from '../../../data/artists.js';
import { gallery } from '../../../lib/gallery.js';

export function getStaticPaths() {
const paths = [];
for (const lang of langs) {
for (const s of styles.filter((x) => x.built)) {
paths.push({ params: { lang, slug: s.slug }, props: { style: s } });
}
}
return paths;
}
const { lang } = Astro.params;
const { style } = Astro.props;
const L = t[lang];
const imgs = gallery(`/images/TattooStyle/${style.folder}`, { exclude: ['Highlight'] });
const heroImg = style.hero ? `/images/TattooStyle/${style.folder}/${style.hero}` : imgs[0];
const featured = (style.artists || []).map((s) => artistsBySlug[s]).filter(Boolean);
const primaryBook = featured[0]?.book;

const title = `${style.name[lang]} Tattoos | UseeTattoo Studio – Berlin`;
// Word-boundary-safe meta description truncation (fixes mid-word cutoffs at 155 chars).
function truncateDescription(text, max = 155) {
  const clean = text.replace(/\n+/g, ' ').trim();
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  const safe = (lastSpace > 0 ? cut.slice(0, lastSpace) : cut).replace(/[\s,;:.\-–—]+$/, '');
  return `${safe}…`;
}
const description = style.metaDescription?.[lang] ? style.metaDescription[lang] : truncateDescription(style.desc[lang]);
const descParas = style.desc[lang].split('\n\n');
const faq = style.faq || [];
const related = (style.related || []).map((s) => stylesBySlug[s]).filter(Boolean);
---
<Base lang={lang} title={title} description={description} ogImage={heroImg}>
<section class="detail-hero">
<div class="wrap">
<div class="s-feature">
<div class="txt dh-txt reveal">
<div class="eyebrow">{L.stylesTitle}</div>
<h1>{style.name[lang]}</h1>
<div class="spec">{style.tagline[lang]}</div>
{descParas.map((para) => <p>{para}</p>)}
{featured.map((a) => (
<div class="s-artist-card">
<img src={a.portrait} alt={a.name} />
<div>
<div class="nm">{a.name}</div>
<div class="rl">{a.specialties[lang]}</div>
</div>
<a class="cta primary" style="background:var(--ink);color:var(--paper);margin-left:auto" href={a.book} target="_blank" rel="noopener">{L.bookNow}</a>
</div>
))}
</div>
<div class="s-img reveal">
<img src={heroImg} alt={style.name[lang]} />
</div>
</div>
</div>
</section>

{imgs.length > 0 && (
<section class="pf" style="padding-top:60px">
<div class="wrap">
<div class="sec-head reveal">
<span class="idx">{L.portfolio}</span>
<h2>{style.name[lang]}</h2>
{primaryBook && <a href={primaryBook} target="_blank" rel="noopener">{L.bookNow} →</a>}
</div>
<div class="pf-masonry reveal">
{imgs.map((src) => (
<a data-lb={src}><img src={src} alt={`${style.name[lang]}, Usee Tattoo`} loading="lazy" /></a>
))}
</div>
</div>
</section>
)}

{faq.length > 0 && (
<section class="style-faq">
<div class="wrap">
<div class="sec-head reveal">
<span class="idx">FAQ</span>
<h2>{lang === 'de' ? 'Häufige Fragen' : 'Common questions'}</h2>
</div>
<div class="faq-list reveal">
{faq.map((item) => (
<details class="faq-item">
<summary>{item.q[lang]}</summary>
<p>{item.a[lang]}</p>
</details>
))}
</div>
</div>
</section>
)}

{related.length > 0 && (
<section class="related-styles">
<div class="wrap">
<div class="sec-head reveal">
<span class="idx">{lang === 'de' ? 'Verwandt' : 'Related'}</span>
<h2>{lang === 'de' ? 'Verwandte Stile' : 'Related styles'}</h2>
</div>
<div class="rel-grid reveal">
{related.map((r) => (
<a class="rel-card" href={`/${lang}/styles/${r.slug}`}>
<span class="rel-name">{r.name[lang]}</span>
<span class="rel-tag">{r.tagline[lang]}</span>
</a>
))}
</div>
</div>
</section>
)}

<style>
.style-faq{padding:80px 0 20px}
.faq-list{max-width:820px;margin-top:8px}
.faq-item{border-top:1px solid var(--line)}
.faq-item:last-child{border-bottom:1px solid var(--line)}
.faq-item summary{cursor:pointer;list-style:none;padding:22px 44px 22px 0;position:relative;font-family:'Cormorant Garamond',serif;font-size:22px;line-height:1.3;color:var(--ink)}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary::after{content:'+';position:absolute;right:4px;top:22px;font-size:22px;color:var(--bronze-dk);transition:transform .3s var(--ease)}
.faq-item[open] summary::after{transform:rotate(45deg)}
.faq-item p{margin:0 0 24px;color:var(--ink-soft);font-size:15.5px;line-height:1.8;max-width:740px}
.related-styles{padding:40px 0 90px}
.rel-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);margin-top:8px}
.rel-card{background:var(--paper);padding:28px 26px;display:flex;flex-direction:column;gap:8px;text-decoration:none;transition:background .3s var(--ease)}
.rel-card:hover{background:var(--paper-2)}
.rel-name{font-family:'Cormorant Garamond',serif;font-size:24px;color:var(--ink)}
.rel-tag{font-family:'Inter',sans-serif;font-size:13.5px;line-height:1.6;color:var(--ink-soft)}
</style>
</Base>
