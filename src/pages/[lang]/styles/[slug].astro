---
import Base from '../../../layouts/Base.astro';
import { t, langs } from '../../../data/i18n.js';
import { styles, stylesBySlug } from '../../../data/styles.js';
import { site } from '../../../data/site.js';
import { artistsBySlug } from '../../../data/artists.js';
import { gallery } from '../../../lib/gallery.js';

export function getStaticPaths() {
const paths = [];
for (const lang of langs) {
for (const s of styles.filter((x) => x.built)) {
paths.push({ params: { lang, slug: s.slug }, props: { style: s } });
}
}
return paths;
}
const { lang } = Astro.params;
const { style } = Astro.props;
const L = t[lang];
const imgs = gallery(`/images/TattooStyle/${style.folder}`, { exclude: ['Highlight'] });
const heroImg = style.hero ? `/images/TattooStyle/${style.folder}/${style.hero}` : imgs[0];
// Don't repeat the hero/cover image inside the gallery grid below it.
const galleryImgs = imgs.filter((src) => src !== heroImg);
const firstWorks = style.firstWorks; // mobile-only first screen, see styles.js
const featured = (style.artists || []).map((s) => artistsBySlug[s]).filter(Boolean);
// consultBook: the visitor must not pick an artist from the style page (ND-309..312), so every booking button goes to the shared consultation.
const primaryBook = style.consultBook ? site.booking.consultation : (style.book?.[lang] || featured[0]?.book);

const title = `${style.name[lang]} Tattoos | UseeTattoo Studio – Berlin`;
const metaTitle = style.metaTitle?.[lang] || title;
// Word-boundary-safe meta description truncation (fixes mid-word cutoffs at 155 chars).
function truncateDescription(text, max = 155) {
  const clean = text.replace(/\n+/g, ' ').trim();
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  const safe = (lastSpace > 0 ? cut.slice(0, lastSpace) : cut).replace(/[\s,;:.\-–—]+$/, '');
  return `${safe}…`;
}
const description = style.metaDescription?.[lang] || truncateDescription(style.desc[lang]);
const faq = style.faq || [];
const related = (style.related || []).map((x) => stylesBySlug[x]).filter(Boolean);
function faqAnswerHtml(item) {
  let text = item.a[lang];
  if (item.link) {
    const anchor = lang === 'de' ? item.link.anchorDe : item.link.anchorEn;
    const href = `/${lang}/artists/${item.link.artist}/`;
    if (anchor && text.includes(anchor)) {
      text = text.replace(anchor, `<a href="${href}">${anchor}</a>`);
    }
  }
  return text;
}
const h1 = style.h1?.[lang] || style.name[lang];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'de' ? 'Startseite' : 'Home', item: `https://useetattoo.com/${lang}/` },
    { '@type': 'ListItem', position: 2, name: h1, item: `https://useetattoo.com/${lang}/styles/${style.slug}/` },
  ],
};
const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q[lang],
    acceptedAnswer: { '@type': 'Answer', text: item.a[lang] },
  })),
} : null;
const descParas = style.desc[lang].split('\n\n');
---
<Base lang={lang} title={metaTitle} description={description} ogImage={heroImg} noLoader={!!firstWorks}>
<section class={firstWorks ? 'detail-hero s-first' : 'detail-hero'}>
<div class="wrap">
<div class="s-feature">
<div class="txt dh-txt reveal">
<div class="eyebrow">{L.stylesTitle}</div>
<h1>{h1}</h1>
<div class="spec">{style.tagline[lang]}</div>
{firstWorks && (
<div class="s-mfirst">
<div class="s-works">
{firstWorks.map((w, i) => (
<a data-lb={w.full}><img src={w.src} alt={w.alt[lang]} width="400" height="500" loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" /></a>
))}
</div>
<a class="cta primary s-mbook" id="sMBook" href={featured[0]?.book || primaryBook} target="_blank" rel="noopener">{L.bookNow}</a>
</div>
)}
{descParas.map((para) => <p>{para}</p>)}
{featured.length === 0 && primaryBook && (<p style="margin-top:24px"><a class="cta primary" style="background:var(--ink);color:var(--paper)" href={primaryBook} target="_blank" rel="noopener">{L.bookNow}</a></p>)}{featured.map((a) => (
<div class="s-artist-card">
<img src={a.portrait} alt={a.name} />
<div>
<div class="nm">{a.name}</div>
<div class="rl">{a.specialties[lang]}</div>
</div>
<a class="cta primary" style="background:var(--ink);color:var(--paper);margin-left:auto" href={a.book} target="_blank" rel="noopener">{L.bookNow}</a>
</div>
))}
<p class="s-book-links" style="margin-top:14px;font-size:14.5px">
<a href={`/${lang}/consultation/#ablauf-section`} style="color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px">&#9432; {L.ablaufCta}</a><br />
<a href="#quick-form" style="display:inline-block;border:1px solid var(--ink);padding:11px 20px;margin:12px 4px 0 0;color:var(--ink);font-weight:600;text-decoration:none;letter-spacing:.04em">{L.jumpForm}</a> · <a href={site.whatsapp} target="_blank" rel="noopener" style="color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px">{L.whatsappCta}</a>
</p>
</div>
<div class="s-img reveal">
<img src={heroImg} alt={style.name[lang]} />
</div>
</div>
</div>
</section>

{galleryImgs.length > 0 && (
<section class="pf" style="padding-top:60px">
<div class="wrap">
<div class="sec-head reveal">
<span class="idx">{L.portfolio}</span>
<h2>{style.name[lang]}</h2>
{primaryBook && <a href={primaryBook} target="_blank" rel="noopener">{L.bookNow} →</a>}
</div>
<div class="pf-masonry reveal">
{galleryImgs.map((src) => (
<a data-lb={src}><img src={src} alt={`${style.name[lang]}, Usee Tattoo`} loading="lazy" /></a>
))}
</div>
</div>
</section>
)}
{faq.length > 0 && (
<section class="s-faq" style="padding-top:60px">
<div class="wrap">
<div class="sec-head reveal">
<h2>FAQ</h2>
</div>
<div class="faq-list reveal">
{faq.map((item) => (
<div class="faq-item" style="padding:20px 0;border-top:1px solid var(--line, #e5e5e5)">
<h3>{item.q[lang]}</h3>
<p set:html={faqAnswerHtml(item)} />
</div>
))}
</div>
</div>
</section>
)}
{related.length > 0 && (
<section class="related-styles" style="padding:30px 0 80px">
<div class="wrap">
<div class="sec-head reveal">
<h2>{lang === 'de' ? 'Verwandte Stile' : 'Related styles'}</h2>
</div>
<div class="reveal" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1px;background:var(--line, #e5e5e5);border:1px solid var(--line, #e5e5e5);margin-top:24px">
{related.map((r) => (
<a href={`/${lang}/styles/${r.slug}/`} style="background:var(--paper, #fff);padding:26px;text-decoration:none;display:flex;flex-direction:column;gap:8px">
<span style="font-family:'Cormorant Garamond',serif;font-size:24px;line-height:1.2;color:var(--ink, #1a1a1a)">{r.name[lang]}</span>
<span style="font-family:'Inter',sans-serif;font-size:13.5px;line-height:1.6;color:var(--ink-soft, #666)">{r.tagline[lang]}</span>
</a>
))}
</div>
</div>
</section>
)}
{lang === 'de' && (
<p class="all-styles-link" style="padding:0 0 40px;text-align:center"><a href="/de/styles/">Alle Stile</a></p>
)}
{firstWorks && (
<>
<a class="s-sticky" id="sSticky" href={featured[0]?.book || primaryBook} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">{L.bookNow}</a>
<style is:global>
/* Mobile first screen for styles with firstWorks (same pattern as the Josef page).
   Desktop (>960px) is untouched: block and sticky exist only below 960px. */
.s-mfirst,.s-sticky{display:none}
@media(max-width:960px){
  .s-first{padding-top:84px}
  .s-first .dh-txt.reveal{opacity:1;transform:none}
  .s-first .dh-txt .eyebrow{margin-bottom:10px}
  .s-first .dh-txt h1{margin-bottom:8px}
  .s-first .dh-txt .spec{margin-bottom:16px}
  .s-mfirst{display:block;margin-bottom:28px}
  .s-works{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
  .s-works a{display:block;cursor:zoom-in;background:#e3ddd1}
  .s-works img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover}
  .s-mfirst .cta.s-mbook{display:block;width:100%;text-align:center;margin-top:14px;background:var(--ink);color:var(--paper)}
  .s-sticky{display:block;position:fixed;left:14px;right:76px;bottom:14px;z-index:79;height:48px;line-height:48px;text-align:center;
    background:var(--ink);color:var(--paper);font-family:'Inter',sans-serif;font-size:12.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
    text-decoration:none;box-shadow:0 6px 24px rgba(0,0,0,.25);transform:translateY(160%);transition:transform .35s cubic-bezier(.22,1,.36,1)}
  .s-sticky.on{transform:none}
}
</style>
<script is:inline>
(function(){
  // Sticky booking button on phones: only after the in-page button scrolled away,
  // never while the cookie banner is open, left of the call/WhatsApp buttons.
  try{
    var st=document.getElementById('sSticky'),btn=document.getElementById('sMBook'),ck=document.getElementById('cookieBanner');
    if(!st||!btn) return;
    var past=false;
    var upd=function(){ var on=past&&!(ck&&!ck.hidden); st.classList.toggle('on',on); st.setAttribute('aria-hidden',on?'false':'true'); st.tabIndex=on?0:-1; };
    new IntersectionObserver(function(es){ es.forEach(function(e){ past=!e.isIntersecting&&e.boundingClientRect.top<0; upd(); }); }).observe(btn);
    if(ck) new MutationObserver(upd).observe(ck,{attributes:true,attributeFilter:['hidden']});
  }catch(e){}
})();
</script>
</>
)}
{faqSchema && (
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>
