---
import Base from '../../layouts/Base.astro';
import { langs } from '../../data/i18n.js';
import { site } from '../../data/site.js';
import { gallery } from '../../lib/gallery.js';
import { journal } from '../../data/journal.js';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const base = `/${lang}`;
const bookUrl = site.booking.piercing;
const imgs = gallery('/images/piercing/gallery');

const c = {
  de: {
    title: 'Piercing in Berlin | UseeTattoo Studio – Charlottenburg',
        description: 'Piercing bei Usee Tattoo Berlin: sterile Einwegnadeln, persönliche Beratung, Titanschmuck. Ohr, Gesicht, Oral und Body. Termin ab 50 €.',
    eyebrow: '/ Piercing',
    h1: 'Piercing in Berlin',
    tagline: 'Präzision. Erfahrung. Für die Dauer gemacht.',
    intro: 'Jedes Piercing ist eine Entscheidung, die dich jeden Tag begleitet. Deshalb sollte sie mit Sorgfalt getroffen werden, nicht in Eile. Bei Usee Tattoo beginnt kein Piercing ohne Beratung. Zuerst sprechen wir über deine Idee, die Platzierung, deine Anatomie, die Schmuckauswahl und all deine Fragen. Wenn wir das Gefühl haben, dass ein Piercing für dich nicht die richtige Wahl ist, sagen wir es dir ehrlich, denn uns ist die richtige Entscheidung wichtiger, als einfach eine Dienstleistung auszuführen.',
    ctaBook: 'Piercing-Termin buchen',
    expectTitle: 'Was dich erwartet',
    expect: [
      ['Persönliche Beratung vor jedem Piercing', 'Um Fragen zu klären, die Anatomie zu prüfen und die beste Option zu wählen.'],
            ['Sterile Einwegnadeln', 'Die von uns verwendete Methode, präzise am Einstichpunkt und schonend für das Gewebe.'],
      ['Hochwertiger Schmuck', 'Das passende Material für den Start, abgestimmt auf Piercing-Art und Hautzustand.'],
      ['Vollständige Pflegeanleitung', 'Alles, was du für eine korrekte Heilung brauchst, bevor du das Studio verlässt.'],
      ['Erster Schmuckwechsel kostenlos', 'Nach der Heilung ist der erste Schmuckwechsel für Usee-Tattoo-Kund:innen gratis.'],
            ['Ruhiger, sauberer Raum', 'Damit deine Erfahrung vom ersten Moment an genauso zählt wie das Ergebnis.'],
    ],
    whyTitle: 'Warum die Beratung wichtig ist',
    why: 'Ein Unterschied, den du bei Usee Tattoo spürst, ist die Zeit, die wir vor dem Piercing investieren. Form und Anatomie der gewählten Stelle, die Dicke des Gewebes, der Winkel, die Art des Schmucks und sogar dein Lebensstil können das Ergebnis und den Heilungsverlauf beeinflussen. Deshalb prüfen wir all das, bevor wir beginnen. Ist eine Wahl nicht geeignet, erklären wir dir den Grund und schlagen auf Wunsch Alternativen vor. Die endgültige Entscheidung liegt immer bei dir, aber sie beruht auf Wissen und Erfahrung, nicht auf Vermutungen.',        : 'Dein Piercing wird von Nana durchgeführt, einer Piercerin mit langjähriger Erfahrung, für die Präzision, Ruhe und Liebe zum Detail ein zentraler Teil ihrer Arbeitsweise sind. Vom ersten Gespräch bis zum Ende der Sitzung nimmt sich Nana ausreichend Zeit für jede:n, damit alle Fragen beantwortet werden und jede Entscheidung mit Sicherheit getroffen wird. Das Ziel ist nicht nur, ein Piercing zu setzen, sondern deine Erfahrung von Anfang bis Ende professionell, ruhig und vertrauenswürdig zu gestalten.',
    nanaTitle: 'Das ist Nana',
    nana: 'Dein Piercing wird von Nana durchgeführt, einer Piercerin mit langjähriger Erfahrung, für die Präzision, Ruhe und Liebe zum Detail ein zentraler Teil ihrer Arbeitsweise sind. Vom ersten Gespräch bis zum Ende der Sitzung nimmt sich Nana ausreichend Zeit für jede:n, damit alle Fragen beantwortet werden und jede Entscheidung mit Sicherheit getroffen wird. Das Ziel ist nicht nur, ein Piercing zu setzen, sondern deine Erfahrung von Anfang bis Ende ruhig, sorgfältig und auf Augenhöhe zu gestalten.',
        gun: 'Alle Piercings bei Usee Tattoo werden mit sterilen Einwegnadeln gesetzt. Diese Methode ermöglicht mehr Präzision an der Einstichstelle, verursacht weniger Gewebeschäden und ist bei uns seit der Eröffnung 2020 der Standard für jedes Piercing. Deshalb verwenden wir keine Piercing-Gun.',
        gunTitle: 'Warum wir keine Piercing-Gun verwenden',
    collTitle: 'Unsere Piercing-Auswahl',
    coll: 'Jedes Piercing hat andere ästhetische Eigenschaften und Heilungszeiten. Wenn du noch unentschlossen bist, finden wir in der Beratung die beste Wahl für deine Anatomie und deinen Geschmack.',
    groups: [
      ['Ohr', '/images/piercing/Ear.webp', 'Lobe · Upper Lobe · Helix · Forward Helix · Flat · Tragus · Anti Tragus · Conch · Daith · Rook · Snug · Industrial · Orbital'],
      ['Gesicht', '/images/piercing/Face.webp', 'Nostril · Septum · Bridge · Eyebrow · Medusa · Monroe · Labret · Lip'],
      ['Oral', '/images/piercing/Oral.webp', 'Tongue'],
      ['Body', '/images/piercing/Body.webp', 'Navel · Nipple'],
    ],
    collNote: 'Microdermal- und Genital-Piercings werden derzeit nicht angeboten.',
    stepsTitle: 'Von der Beratung bis zur Fertigstellung',
    steps: [
      ['Beratung', 'Idee besprechen, Fragen klären und die beste Option wählen.'],
      ['Platzierung', 'Die genaue Stelle unter Berücksichtigung der Anatomie markieren.'],
      ['Sterile Vorbereitung', 'Vollständige Desinfektion der Haut und Vorbereitung steriler Instrumente.'],
      ['Piercing', 'Das Piercing mit steriler Einwegnadel und Einsetzen des Erstschmucks.'],
      ['Nachsorge', 'Deine Pflegeanleitung und Antworten auf letzte Fragen, bevor du gehst.'],
    ],
    healTitle: 'Heilung auf einen Blick',
    healHead: ['Piercing', 'Schmerz', 'Ø Heilung'],
    heal: [
      ['Lobe', 2, '6–8 Wochen'], ['Helix', 3, '6–12 Monate'], ['Tragus', 3, '6–12 Monate'],
      ['Conch', 4, '6–12 Monate'], ['Daith', 4, '6–9 Monate'], ['Nostril', 3, '3–6 Monate'],
      ['Septum', 3, '2–3 Monate'], ['Eyebrow', 2, '2–3 Monate'], ['Lip', 3, '2–3 Monate'],
      ['Tongue', 4, '4–8 Wochen'], ['Navel', 3, '6–12 Monate'], ['Nipple', 5, '6–12 Monate'],
    ],
    healNote: 'Schmerz und Heilungsdauer sind individuell verschieden; diese Tabelle ist nur ein grober Richtwert.',
    jewTitle: 'Den richtigen Schmuck wählen',
    jew: 'Der Erstschmuck ist mehr als nur das Aussehen des Piercings; die richtige Wahl beeinflusst auch Komfort und Heilung. Deshalb wird der Schmuck nach Platzierung, passenden Maßen und Hautzustand ausgewählt. Im Studio bieten wir außerdem eine Auswahl an Piercing-Schmuck an, damit du nach der Heilung in Ruhe dein Lieblingsmodell wählen kannst.',
    jewHead: ['Material', 'Empfohlen', 'Hypoallergen'],
    jewRows: [['Implant Grade Titanium', 5, 5], ['Surgical Steel', 4, 4], ['Gold (14K / 18K)', 4, 5]],
    afterTitle: 'Nachsorge',
    after: 'Die Heilung ist ein natürlicher Teil des Piercing-Prozesses. Ein paar einfache Regeln können sie deutlich erleichtern.',
    doTitle: 'Empfohlen',
    doList: ['Wasche deine Hände, bevor du das Piercing berührst.', 'Verwende nur empfohlene Produkte zur Reinigung.', 'Lass deinen Körper natürlich heilen.', 'Bei Fragen wende dich jederzeit ans Studio.'],
    dontTitle: 'Besser vermeiden',
    dontList: ['Am Schmuck spielen oder drehen.', 'Druck oder Stöße auf die Stelle.', 'Schmuck vor Abschluss der Heilung wechseln.'],
    faqTitle: 'Häufige Fragen',
    faq: [
      ['Tut ein Piercing weh?', 'Die meisten beschreiben den Schmerz als kurz und gut auszuhalten. Er hängt von der Stelle und der Empfindlichkeit jeder Person ab.'],
      ['Wie lange dauert ein Piercing?', 'Der eigentliche Vorgang dauert meist nur wenige Minuten. Die Zeit geht vor allem in Beratung, Vorbereitung und Schmuckauswahl.'],
      ['Kann ich eigenen Schmuck mitbringen?', 'Wenn Material, Größe und Hygiene passen, können wir ihn prüfen.'],
      ['Wann erfolgt der erste Schmuckwechsel?', 'Der richtige Zeitpunkt hängt von Piercing-Art und Heilung ab. Bei Bedarf berät dich unser Team.'],
      ['Was, wenn es mein erstes Piercing ist?', 'Das ist völlig normal. Wenn es dein erstes Mal ist, erklären wir dir vorab jeden Schritt, damit du in Ruhe entscheiden kannst.'],
      ['Besteht das Risiko von Migration oder Abstoßung?', 'Bei einigen Oberflächen-Piercings oder wenn Material und Stärke nicht passen, besteht dieses Risiko. Die richtige Wahl von Material und Größe von Anfang an, an der wir in der Beratung arbeiten, ist der wichtigste vorbeugende Faktor.'],
      ['Bietet ihr auch Piercings für Kinder an?', 'Ja, Ohrpiercings führen wir auch bei Kindern durch.'],
      ['Was ist das Mindestalter?', 'Für unter 18-Jährige ist bei allen Piercings (nicht nur am Ohrläppchen) die Zustimmung der Eltern erforderlich.'],
      ['Was kostet ein Piercing?', 'Jedes Piercing kostet 50 €, der erste Schmuckwechsel ist kostenlos.'],
    ],
    galleryTitle: 'Aus dem Studio',
    readyTitle: 'Bereit, wenn du es bist',
    ready: 'Ein gutes Piercing endet nicht am Tag des Termins; das Ergebnis entsteht aus der richtigen Entscheidung, präziser Ausführung und guter Pflege. Wenn du bereit bist, kannst du online buchen oder uns für eine Beratung kontaktieren.',
    journalTitle: 'Piercing Journal',
    journalIntro: 'Ratgeber und Antworten rund um Pflege, Heilung und die richtige Wahl.',
    readMore: 'Weiterlesen',
    painLabel: 'Schmerz',
  },
  en: {
    title: 'Piercing in Berlin | UseeTattoo Studio – Charlottenburg',
    description: 'Piercing at Usee Tattoo Berlin: sterile single-use needles, private consultation, high-quality jewelry. Ear, face, oral and body. Appointments from €50.',
    eyebrow: '/ Piercing',
    h1: 'Piercing in Berlin',
    tagline: 'Precision. Experience. Designed to Last.',
    intro: "Every piercing is a decision you carry with you every day. That's why we believe it should be made with care, not in a rush. At Usee Tattoo, no piercing begins without a consultation. First, we talk about your idea, the placement, your anatomy, the choice of jewelry and any questions you have. If we feel a piercing isn't the right choice for you, we'll tell you honestly, because we'd rather make one right decision than simply perform a service.",
    ctaBook: 'Book a piercing appointment',
    expectTitle: 'What You Can Expect',
    expect: [
      ['Private consultation before every piercing', 'To answer your questions, assess your anatomy and choose the best option.'],
            ['Sterile single-use needles', 'The method we use, precise at the entry point and gentler on the surrounding tissue.'],
      ['High-quality jewelry', 'The right material for the start, chosen for the piercing type and your skin.'],
      ['A complete aftercare guide', 'Everything you need for correct healing, before you leave the studio.'],
      ['First jewelry change free', 'After healing, the first jewelry change is free for Usee Tattoo clients.'],
            ['A calm, clean space', 'So your experience matters as much as the result, from the very first moment.'],
    ],
    whyTitle: 'Why Consultation Matters',
        why: "One thing you'll notice at Usee Tattoo is the time we spend before the piercing. The shape and anatomy of the chosen spot, the thickness of the tissue, the angle, the type of jewelry and even your lifestyle can affect the final result and the healing. That's why we review all of this before we start. If a choice isn't suitable, we explain why and, if you like, suggest alternatives. The final decision is always yours, but it's based on information and experience, not guesswork.",
    nanaTitle: 'Meet Nana',
        nana: "Your piercing is done by Nana, a piercer with years of experience for whom precision, calm and attention to detail are a core part of how she works. From the first conversation to the end of the session, Nana takes enough time for every client so that all questions are answered and every decision is made with confidence. The goal isn't just to perform a piercing; it's to make your experience calm, careful and reassuring from start to finish.",
    gunTitle: "Why We Don't Use a Piercing Gun",
        gun: "All piercings at Usee Tattoo are done with sterile single-use needles. This method allows for greater precision where the jewelry enters, causes less tissue damage and has been our standard for every piercing since we opened in 2020. That's why we don't use a piercing gun.",
    collTitle: 'Our Piercing Collection',
    coll: "Every piercing has different aesthetic qualities and healing times. If you're still undecided, we'll find the best choice for your anatomy and taste during the consultation.",
    groups: [
      ['Ear', '/images/piercing/Ear.webp', 'Lobe · Upper Lobe · Helix · Forward Helix · Flat · Tragus · Anti Tragus · Conch · Daith · Rook · Snug · Industrial · Orbital'],
      ['Face', '/images/piercing/Face.webp', 'Nostril · Septum · Bridge · Eyebrow · Medusa · Monroe · Labret · Lip'],
      ['Oral', '/images/piercing/Oral.webp', 'Tongue'],
      ['Body', '/images/piercing/Body.webp', 'Navel · Nipple'],
    ],
    collNote: 'Microdermal and genital piercings are currently not offered.',
    stepsTitle: 'From Consultation to Completion',
    steps: [
      ['Consultation', 'Reviewing your idea, answering questions and choosing the best option.'],
      ['Placement', 'Marking the exact spot with attention to your anatomy.'],
      ['Sterile Preparation', 'Full skin disinfection and preparation of sterile equipment.'],
      ['Piercing', 'The piercing with a sterile single-use needle and insertion of the initial jewelry.'],
      ['Aftercare', 'Your aftercare guide and answers to any last questions before you leave.'],
    ],
    healTitle: 'Healing at a Glance',
    healHead: ['Piercing', 'Pain Level', 'Average Healing'],
    heal: [
      ['Lobe', 2, '6–8 weeks'], ['Helix', 3, '6–12 months'], ['Tragus', 3, '6–12 months'],
      ['Conch', 4, '6–12 months'], ['Daith', 4, '6–9 months'], ['Nostril', 3, '3–6 months'],
      ['Septum', 3, '2–3 months'], ['Eyebrow', 2, '2–3 months'], ['Lip', 3, '2–3 months'],
      ['Tongue', 4, '4–8 weeks'], ['Navel', 3, '6–12 months'], ['Nipple', 5, '6–12 months'],
    ],
    healNote: 'Pain and healing time vary from person to person; this table is only a general guide.',
    jewTitle: 'Choosing the Right Jewelry',
    jew: "The initial jewelry is more than just how the piercing looks; the right choice can affect comfort and healing too. That's why jewelry is selected based on the location, the correct dimensions and your skin. We also offer a selection of piercing jewelry in the studio, so after healing you can choose the model you like with confidence.",
    jewHead: ['Material', 'Recommended', 'Hypoallergenic'],
    jewRows: [['Implant Grade Titanium', 5, 5], ['Surgical Steel', 4, 4], ['Gold (14K / 18K)', 4, 5]],
    afterTitle: 'Aftercare',
    after: 'Healing is a natural part of the piercing process. A few simple habits can make it noticeably easier.',
    doTitle: 'Recommended',
    doList: ['Wash your hands before touching the piercing.', 'Use only recommended products for cleaning.', 'Let your body heal naturally.', 'Contact the studio with any questions.'],
    dontTitle: 'Better to avoid',
    dontList: ['Playing with or twisting the jewelry.', 'Applying pressure or knocks to the piercing.', 'Changing jewelry before healing is complete.'],
    faqTitle: 'Frequently Asked Questions',
    faq: [
      ['Does getting a piercing hurt?', 'Most people describe the pain as brief and easy to tolerate. It depends on the location and each person’s sensitivity.'],
      ['How long does a piercing take?', 'The procedure itself usually takes only a few minutes. Most of the time goes into consultation, preparation and jewelry selection.'],
      ['Can I bring my own jewelry?', 'If the material, size and hygiene are suitable, we can review it.'],
      ['When is the first jewelry change?', 'The right time depends on the piercing type and healing. Our team will guide you if needed.'],
      ['What if it’s my first piercing?', 'That’s completely normal. If it’s your first time, we explain every step beforehand so you can decide calmly.'],
      ['Is there a risk of migration or rejection?', 'With some surface piercings, or when the material and thickness aren’t right, this risk exists. Choosing the correct material and size from the start, which we work on in the consultation, is the most important preventive factor.'],
      ['Do you pierce children?', 'Yes, we do ear piercings for children too.'],
      ['What is the minimum age?', 'For under 18, parental consent is required for all piercings (not only the earlobe).'],
      ['How much does a piercing cost?', 'Each piercing is €50, and the first jewelry change is free.'],
    ],
    galleryTitle: 'From the studio',
    readyTitle: 'Ready When You Are',
    ready: "A good piercing isn't limited to the day it's done; the result comes from the right decision, precise execution and proper care. If you're ready, you can book online or contact us for a consultation.",
    journalTitle: 'Piercing Journal',
    journalIntro: 'Guides and answers on care, healing and choosing the right piece.',
    readMore: 'Read more',
    painLabel: 'Pain',
  },
}[lang];

const stars = (n) => '★'.repeat(n) + '☆'.repeat(5 - n);
---
<Base lang={lang} title={c.title} description={c.description} ogImage="/images/piercing/Ear.webp">
  <section class="detail-hero pc-hero">
    <div class="wrap">
      <div class="dh-txt reveal" style="max-width:820px">
        <div class="eyebrow">{c.eyebrow}</div>
        <h1>{c.h1}</h1>
        <div class="pc-tag">{c.tagline}</div>
        <p class="bio" style="max-width:660px;font-size:18px">{c.intro}</p>
        <div class="cta-row">
          <a class="cta primary" style="background:var(--ink);color:var(--paper)" href={bookUrl} target="_blank" rel="noopener">{c.ctaBook}</a>
        </div>
      </div>
      <div class="pc-hero-banner reveal"><img src="/images/piercing/Piercing_M_12.png" alt="Piercing jewelry and curated ear, Usee Tattoo Berlin" /></div>
    </div>
  </section>

  <!-- WHAT YOU CAN EXPECT -->
  <section class="artists" style="padding:90px 0">
    <div class="wrap">
      <h2 class="pc-h2 reveal" style="margin-bottom:44px">{c.expectTitle}</h2>
      <div class="pc-expect reveal">
        {c.expect.map(([t, d], i) => (
          <div class="pc-ex"><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY CONSULTATION + NANA -->
  <section>
    <div class="wrap pc-split">
      <div class="reveal">
        <h2 class="pc-h2">{c.whyTitle}</h2>
        <p class="pc-p">{c.why}</p>
      </div>
      <div class="reveal pc-card">
        <h3 class="pc-col-t">{c.nanaTitle}</h3>
        <p class="pc-p">{c.nana}</p>
        <a class="link-underline" href={`${base}/artists/nana`}>Nana →</a>
      </div>
    </div>
  </section>

  <!-- NO GUN -->
  <section class="artists" style="padding:70px 0">
    <div class="wrap" style="text-align:center;max-width:760px">
      <h2 class="pc-h2 reveal" style="margin-bottom:18px">{c.gunTitle}</h2>
      <p class="pc-p reveal" style="margin:0 auto;max-width:640px">{c.gun}</p>
    </div>
  </section>

  <!-- COLLECTION -->
  <section>
    <div class="wrap">
      <h2 class="pc-h2 reveal">{c.collTitle}</h2>
      <p class="pc-p reveal" style="margin-bottom:44px">{c.coll}</p>
      <div class="pc-coll reveal">
        {c.groups.map(([name, img, list]) => (
          <div class="pc-grp">
            <div class="pc-grp-img"><img src={img} alt={`${name} piercing guide, Usee Tattoo`} loading="lazy" /></div>
            <div class="pc-grp-txt">
              <h3>{name}</h3>
              <p>{list}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="pc-note reveal">{c.collNote}</p>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="artists" style="padding:90px 0">
    <div class="wrap">
      <h2 class="pc-h2 reveal" style="margin-bottom:44px">{c.stepsTitle}</h2>
      <div class="pc-steps reveal">
        {c.steps.map(([t, d], i) => (
          <div class="pc-step"><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- HEALING TABLE -->
  <section>
    <div class="wrap" style="max-width:820px">
      <h2 class="pc-h2 reveal" style="margin-bottom:30px">{c.healTitle}</h2>
      <div class="pc-table-wrap reveal">
        <table class="pc-table">
          <thead><tr><th>{c.healHead[0]}</th><th>{c.healHead[1]}</th><th>{c.healHead[2]}</th></tr></thead>
          <tbody>
            {c.heal.map(([p, pain, heal]) => (
              <tr><td>{p}</td><td class="pc-stars">{stars(pain)}</td><td>{heal}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pc-note reveal">{c.healNote}</p>
    </div>
  </section>

  <!-- JEWELRY TABLE -->
  <section class="artists" style="padding:90px 0">
    <div class="wrap" style="max-width:820px">
      <h2 class="pc-h2 reveal" style="margin-bottom:18px">{c.jewTitle}</h2>
      <p class="pc-p reveal" style="margin-bottom:30px">{c.jew}</p>
      <div class="pc-table-wrap reveal">
        <table class="pc-table">
          <thead><tr><th>{c.jewHead[0]}</th><th>{c.jewHead[1]}</th><th>{c.jewHead[2]}</th></tr></thead>
          <tbody>
            {c.jewRows.map(([m, r, h]) => (
              <tr><td>{m}</td><td class="pc-stars">{stars(r)}</td><td class="pc-stars">{stars(h)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- AFTERCARE -->
  <section>
    <div class="wrap">
      <h2 class="pc-h2 reveal">{c.afterTitle}</h2>
      <p class="pc-p reveal" style="margin-bottom:40px">{c.after}</p>
      <div class="pc-cols reveal">
        <div class="pc-col">
          <h3 class="pc-col-t ok">{c.doTitle}</h3>
          <ul>{c.doList.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="pc-col">
          <h3 class="pc-col-t warn">{c.dontTitle}</h3>
          <ul>{c.dontList.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  {imgs.length > 0 && (
    <section class="gallery">
      <div class="wrap">
        <div class="sec-head reveal"><span class="idx">Piercing</span><h2>{c.galleryTitle}</h2><a href={site.social.instagram} target="_blank" rel="noopener">@usee.tattoo →</a></div>
        <div class="pc-gallery reveal">
          {imgs.slice(0, 12).map((src) => <div class="cell"><a data-lb={src}><img src={src} alt="Usee Tattoo piercing" loading="lazy" /></a></div>)}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="faq" style="padding:90px 0">
    <div class="wrap">
      <div class="sec-head reveal"><span class="idx">FAQ</span><h2>{c.faqTitle}</h2></div>
      <div class="faq-list acc-single reveal">
        {c.faq.map(([q, a], i) => (
          <details open={i === 0}>
            <summary><span>{q}</span><span class="plus">+</span></summary>
            <div class="ans">{a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- READY / CTA -->
  <section class="artists" style="padding:80px 0">
    <div class="wrap" style="text-align:center;max-width:760px">
      <h2 class="pc-h2 reveal" style="margin-bottom:16px">{c.readyTitle}</h2>
      <p class="pc-p reveal" style="margin:0 auto 30px;max-width:620px">{c.ready}</p>
      <div class="reveal"><a class="cta primary" style="background:var(--ink);color:var(--paper)" href={bookUrl} target="_blank" rel="noopener">{c.ctaBook}</a></div>
    </div>
  </section>

  <!-- JOURNAL -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="idx">Journal</span><h2>{c.journalTitle}</h2></div>
      <p class="pc-p reveal" style="margin:-30px 0 40px">{c.journalIntro}</p>
      <div class="pc-journal reveal">
        {journal.map((a) => (
          <a class="pc-art" href={`${base}/piercing/journal/${a.slug}`}>
            <div class="pc-art-body">
              <span class="pc-art-tag">{a.tag[lang]}</span>
              <h3>{a.title[lang]}</h3>
              <p>{a.excerpt[lang]}</p>
              <span class="pc-art-more">{c.readMore} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .pc-hero{padding-bottom:56px}
    .pc-hero .pc-tag{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:22px;color:var(--bronze-dk);margin:2px 0 22px}
    .pc-hero .cta-row{margin-top:10px}
    .pc-hero-banner{margin-top:36px}
    .pc-hero-banner img{width:100%;max-width:900px;height:auto;display:block;margin:0}
    .pc-h2{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(28px,4vw,42px);margin:0 0 20px;line-height:1.15}
    .pc-p{color:var(--ink-soft);font-size:16px;line-height:1.85;margin-bottom:16px;max-width:680px}
    .pc-split{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:start}
    .pc-card{border:1px solid var(--line);padding:34px;background:var(--paper)}
    .pc-col-t{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:24px;margin-bottom:16px}
    .pc-expect{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
    .pc-ex{background:var(--paper-2);padding:30px 24px}
    .pc-ex .n{font-size:11px;letter-spacing:.2em;color:var(--bronze)}
    .pc-ex h3{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:20px;margin:10px 0 10px}
    .pc-ex p{color:var(--ink-soft);font-size:13.5px;line-height:1.65}
    .pc-coll{display:grid;grid-template-columns:1fr 1fr;gap:20px}
    .pc-grp{background:var(--paper);border:1px solid var(--line);overflow:hidden}
    .pc-grp-img{width:100%;background:#ece7de;display:flex;align-items:center;justify-content:center;padding:8px}
    .pc-grp-img img{width:auto;max-width:100%;max-height:560px;height:auto;object-fit:contain}
    .pc-grp-txt{padding:20px 26px 26px;text-align:center}
    .pc-grp h3{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:24px;margin-bottom:8px}
    .pc-grp p{color:var(--ink-soft);font-size:14px;line-height:1.75}
    .pc-note{color:var(--bronze-dk);font-style:italic;font-family:'Cormorant Garamond',serif;font-size:18px;margin-top:26px}
    .pc-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:24px}
    .pc-step .n{font-family:'Cormorant Garamond',serif;font-size:32px;color:var(--bronze)}
    .pc-step h3{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:20px;margin:6px 0 8px}
    .pc-step p{color:var(--ink-soft);font-size:13.5px;line-height:1.65}
    .pc-table-wrap{overflow-x:auto}
    .pc-table{width:100%;border-collapse:collapse;font-size:15px}
    .pc-table th{text-align:left;font-family:'Inter',sans-serif;font-weight:600;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--bronze-dk);padding:12px 16px;border-bottom:1px solid var(--line)}
    .pc-table td{padding:13px 16px;border-bottom:1px solid rgba(216,210,198,.55);color:var(--ink-soft)}
    .pc-table td:first-child{color:var(--ink)}
    .pc-stars{color:var(--bronze);letter-spacing:2px;white-space:nowrap}
    .pc-cols{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line)}
    .pc-col{background:var(--paper);padding:36px}
    .pc-col-t.ok::before{content:"✓ ";color:var(--bronze)}
    .pc-col-t.warn::before{content:"✕ ";color:var(--bronze-dk)}
    .pc-col ul{list-style:none}
    .pc-col li{padding:10px 0;color:var(--ink-soft);font-size:15px;border-bottom:1px solid rgba(216,210,198,.5)}
    .pc-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
    .pc-gallery .cell{aspect-ratio:1/1;overflow:hidden;background:#161514;cursor:pointer}
    .pc-gallery img{width:100%;height:100%;object-fit:cover;transition:transform 1s var(--ease)}
    .pc-gallery .cell:hover img{transform:scale(1.06)}
    .pc-journal{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
    .pc-art{display:block;text-decoration:none;color:var(--ink);border:1px solid var(--line);background:var(--paper);transition:border-color .5s var(--ease),transform .5s var(--ease)}
    .pc-art:hover{border-color:var(--bronze);transform:translateY(-3px)}
    .pc-art-body{padding:28px 26px 30px}
    .pc-art-tag{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--bronze)}
    .pc-art h3{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:23px;margin:12px 0 10px;line-height:1.25}
    .pc-art p{color:var(--ink-soft);font-size:14px;line-height:1.7;margin-bottom:16px}
    .pc-art-more{font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--bronze-dk)}
    @media(max-width:900px){
      .pc-split{grid-template-columns:1fr;gap:34px}
      .pc-expect{grid-template-columns:1fr 1fr}
      .pc-steps{grid-template-columns:1fr 1fr}
      .pc-journal{grid-template-columns:1fr}
      .pc-gallery{grid-template-columns:repeat(3,1fr)}
    }
    @media(max-width:560px){
      .pc-expect{grid-template-columns:1fr}
      .pc-coll{grid-template-columns:1fr}
      .pc-steps{grid-template-columns:1fr}
      .pc-cols{grid-template-columns:1fr}
      .pc-gallery{grid-template-columns:repeat(2,1fr)}
    }
  </style>
</Base>
