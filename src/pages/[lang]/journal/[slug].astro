---
// Tattoo Journal article (ND-346c / ND-377). Text: src/data/tattooJournal.js (v2.3, SEO Content).
// Layout follows the live Piercing Journal (/de/piercing/journal/<slug>/).
import Base from '../../../layouts/Base.astro';
import { langs } from '../../../data/i18n.js';
import { site } from '../../../data/site.js';
import { tattooJournal, tattooJournalById, tattooArticlePath, HEALED_PAGE_LIVE, KLAERUNG_OPEN } from '../../../data/tattooJournal.js';

export function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const a of tattooJournal) {
      paths.push({ params: { lang, slug: a.slug[lang] }, props: { article: a } });
    }
  }
  return paths;
}
const { lang } = Astro.params;
const { article } = Astro.props;
const others = tattooJournal.filter((a) => a.id !== article.id && a.series === article.series);
const alternates = { de: tattooArticlePath(article, 'de'), en: tattooArticlePath(article, 'en') };

const ui = {
  de: { crumb: 'Journal', read: 'Lesezeit', cta: 'Neues Tattoo planen', waPre: 'Fragen zu deinem Tattoo? ', wa: 'Schreib uns auf WhatsApp.', more: 'Weiterlesen', faq: 'FAQ', signoff: 'Usee Tattoo, Neue Kantstraße 6, Berlin-Charlottenburg. Seit 2020.' },
  en: { crumb: 'Journal', read: 'Reading time', cta: 'Plan a new tattoo', waPre: 'Questions about your tattoo? ', wa: 'Message us on WhatsApp.', more: 'Continue reading', faq: 'FAQ', signoff: 'Usee Tattoo, Neue Kantstraße 6, Berlin-Charlottenburg. Since 2020.' },
}[lang];

const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// [[a2|anchor]] -> link to that article in the same language
const rich = (s) => esc(s)
  .replace(/\[\[([^|\]]+)\|([^\]]+)\]\]/g, (_, to, text) =>
    `<a class="jn-inline" href="${to.startsWith('/') ? to : tattooArticlePath(tattooJournalById[to], lang)}">${text}</a>`)
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

// Proof line for the price article: rating and count only from site.js, never typed.
const proof = lang === 'de'
  ? `${site.reviews.rating.de} ★ aus ${site.reviews.count} ${site.reviews.de} · Neue Kantstraße 6, Charlottenburg · seit 2020`
  : `${site.reviews.rating.en} ★ from ${site.reviews.count} ${site.reviews.en} · Neue Kantstraße 6, Charlottenburg · since 2020`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: article.faq[lang].map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base lang={lang} title={article.metaTitle[lang]} description={article.metaDesc[lang]} alternates={alternates} ogImage={article.hero}>
  <article class="jn">
    <div class="wrap jn-wrap">
      <a class="link-underline jn-crumb" href={`/${lang}/journal/`}>&larr; {ui.crumb}</a>
      <div class="jn-tag reveal">{article.label[lang]}</div>
      <h1 class="jn-title reveal">{article.h1[lang]}</h1>
      <div class="jn-meta reveal">{ui.read}: {article.readTime[lang]}</div>
      {article.hero && <img class="jn-hero" src={article.hero} alt="" width="768" height="1024" loading="eager" />}

      <div class="jn-body">
        {article.body[lang].map((blk) => (
          <section class="jn-block reveal">
            {blk.h && <h2>{blk.h}</h2>}
            {blk.c.map((item) =>
              typeof item === 'string' ? <p set:html={rich(item)} /> :
              item.klaerung ? (KLAERUNG_OPEN && <p class="jn-klaerung">[{item.klaerung}]</p>) :
              item.ul ? <ul>{item.ul.map((li) => <li set:html={rich(li)} />)}</ul> :
              <ol>{item.ol.map((li) => <li set:html={rich(li)} />)}</ol>
            )}
          </section>
        ))}
      </div>

      {HEALED_PAGE_LIVE && article.healedHref && (
        <p class="jn-healed reveal"><a class="link-underline" href={article.healedHref[lang]}>{article.healedLink[lang]}</a></p>
      )}

      <div class="jn-cta reveal">
        <a class="cta primary" style="background:var(--ink);color:var(--paper)" href={`/${lang}/consultation/`}>{article.cta ? article.cta[lang] : ui.cta}</a>
        {!article.noWhatsApp && <p class="jn-wa">{ui.waPre}<a href={site.whatsapp} target="_blank" rel="noopener">{ui.wa}</a></p>}
      </div>

      <section class="jn-faq reveal">
        <h2>{ui.faq}</h2>
        {article.faq[lang].map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
        {KLAERUNG_OPEN && article.faqKlaerung && <p class="jn-klaerung">[{article.faqKlaerung[lang]}]</p>}
      </section>

      <p class="jn-signoff">{article.proofLine ? proof : ui.signoff}</p>

      {(others.length > 0 || article.extraLinks.length > 0) && <div class="jn-more reveal">
        <span class="jn-more-h">{ui.more}</span>
        <div class="jn-more-grid">
          {others.map((a) => (
            <a class="jn-more-card" href={tattooArticlePath(a, lang)}>
              <span class="t">{a.label[lang]}</span>
              <h3>{a.h1[lang]}</h3>
            </a>
          ))}
          {article.extraLinks.map((l) => (
            <a class="jn-more-card" href={l.href[lang]}>
              <h3>{l.text[lang]}</h3>
            </a>
          ))}
        </div>
      </div>}
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <style>
    .jn{padding:70px 0 100px}
    .jn-wrap{max-width:760px}
    .jn-crumb{font-size:11px;display:inline-block;margin-bottom:36px}
    .jn-tag{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--bronze);margin-bottom:14px}
    .jn-title{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(30px,5vw,50px);line-height:1.12;margin:0 0 14px}
    .jn-meta{font-size:12px;letter-spacing:.06em;color:var(--ink-soft);padding-bottom:30px;border-bottom:1px solid var(--line);margin-bottom:30px}
    .jn-block{margin-bottom:34px}
    .jn-block h2{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(22px,3vw,28px);margin:0 0 14px}
    .jn-block p{color:var(--ink-soft);font-size:16.5px;line-height:1.85;margin:0 0 16px}
    .jn-block ul,.jn-block ol{margin:0 0 16px;padding-left:20px}
    .jn-block li{color:var(--ink-soft);font-size:16px;line-height:1.7;margin-bottom:8px}
    .jn-block :global(.jn-inline){color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px;font-style:italic}
    .jn-healed{margin:0 0 30px}
    .jn-hero{display:block;width:100%;height:auto;max-height:460px;object-fit:cover;margin:0 0 34px}
    .jn-klaerung{background:#fff4c2;color:#5a4500 !important;border-left:3px solid #d9a400;padding:10px 14px;font-size:14px !important}
    .jn-cta{border:1px solid var(--line);background:var(--paper-2);padding:38px 34px;text-align:center;margin:50px 0}
    .jn-wa{color:var(--ink-soft);font-size:15px;line-height:1.7;margin:20px 0 0}
    .jn-wa a{color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px}
    .jn-faq{margin:0 0 40px}
    .jn-faq h2{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(22px,3vw,28px);margin:0 0 14px}
    .jn-faq details{border-top:1px solid var(--line);padding:16px 0}
    .jn-faq details:last-child{border-bottom:1px solid var(--line)}
    .jn-faq summary{cursor:pointer;font-size:16px;color:var(--ink);line-height:1.5}
    .jn-faq details p{color:var(--ink-soft);font-size:15.5px;line-height:1.8;margin:12px 0 0}
    .jn-signoff{font-size:13px;color:var(--ink-soft);margin:0 0 40px}
    .jn-more-h{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--bronze-dk)}
    .jn-more-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px}
    .jn-more-card{display:block;text-decoration:none;color:var(--ink);border:1px solid var(--line);padding:22px 20px;transition:border-color .5s var(--ease)}
    .jn-more-card:hover{border-color:var(--bronze)}
    .jn-more-card .t{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--bronze);font-weight:600}
    .jn-more-card h3{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:19px;margin-top:8px;line-height:1.25}
    @media(max-width:560px){.jn-more-grid{grid-template-columns:1fr}}
  </style>
</Base>
