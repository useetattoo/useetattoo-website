---
// Tattoo Journal overview (ND-346c). ND-392: simple title until SEO Content sends the
// final title/meta; the description is built only from the approved article labels.
import Base from '../../../layouts/Base.astro';
import { langs } from '../../../data/i18n.js';
import { tattooJournal, tattooArticlePath } from '../../../data/tattooJournal.js';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const ui = {
  de: { title: 'Journal | Usee Tattoo Berlin', h1: 'Journal', read: 'Lesezeit' },
  en: { title: 'Journal | Usee Tattoo Berlin', h1: 'Journal', read: 'Reading time' },
}[lang];
const description = tattooJournal.map((a) => a.label[lang]).join(' · ') + ' — Usee Tattoo, Berlin-Charlottenburg.';
---
<Base lang={lang} title={ui.title} description={description}>
  <section class="jx">
    <div class="wrap jx-wrap">
      <h1 class="jx-title reveal">{ui.h1}</h1>
      <div class="jx-list">
        {tattooJournal.map((a) => (
          <a class="jx-card reveal" href={tattooArticlePath(a, lang)}>
            <span class="t">{a.label[lang]}</span>
            <h2>{a.h1[lang]}</h2>
            <p>{a.metaDesc[lang]}</p>
            <span class="r">{ui.read}: {a.readTime[lang]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <style>
    .jx{padding:70px 0 100px}
    .jx-wrap{max-width:860px}
    .jx-title{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(36px,6vw,60px);line-height:1.05;margin:0 0 36px}
    .jx-list{display:grid;gap:18px}
    .jx-card{display:block;text-decoration:none;color:var(--ink);border:1px solid var(--line);padding:26px 24px;transition:border-color .5s var(--ease)}
    .jx-card:hover{border-color:var(--bronze)}
    .jx-card .t{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--bronze);font-weight:600}
    .jx-card h2{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(22px,3vw,28px);margin:10px 0 10px;line-height:1.2}
    .jx-card p{color:var(--ink-soft);font-size:15.5px;line-height:1.75;margin:0 0 12px}
    .jx-card .r{font-size:12px;letter-spacing:.06em;color:var(--ink-soft)}
  </style>
</Base>
