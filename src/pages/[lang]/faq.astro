---
import Base from '../../layouts/Base.astro';
import { langs, t } from '../../data/i18n.js';
import { site } from '../../data/site.js';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const L = t[lang];

// Full FAQ from the studio's own answers, adapted to the agreed positioning:
// no price anchor, no "free/kostenlose", single location; "both locations" question removed.
// Each item is [question, answer] or [question, answer, anchorId]. An anchorId turns the
// <details> into a link target, so other pages can deep-link straight to one answer.
const faq = {
  de: {
    title: 'FAQ | UseeTattoo Studio – Berlin',
    description: 'Häufige Fragen zu Preisen, Beratung, Cover-ups, Terminen, Pflege und Anzahlung bei Usee Tattoo Berlin.',
    h1: 'Häufige Fragen',
    items: [
      ['Wie viel kostet ein Tattoo?', 'Kleine Walk-in-Tattoos beginnen bei 100 €. Der genaue Preis richtet sich nach Größe und Detailgrad und steht fest, bevor gestochen wird. Bei größeren Motiven hängt der Preis an Größe, Detailgrad, Körperstelle und der Zahl der Sitzungen. Deshalb gibt es dafür keine Preisliste, sondern einen Festpreis. Er wird in der Beratung zusammen mit dem Entwurf festgelegt, bei größeren Motiven mit Sitzungsplan. Du kennst ihn, bevor du einen Termin bestätigst. Am Tag selbst kommt nichts dazu.'],
      ['Kann ich auch kurzfristig einen Termin bekommen?', 'Ja, für kleinere Motive. Walk-ins nehmen wir Montag bis Samstag von 11 bis 19 Uhr an, je nach Auslastung des Tages, gestochen nur von Resident-Artists. Begonnen wird nur, was in derselben Sitzung fertig wird. Das sagen wir dir vor der Zusage. Große Motive, Cover-ups und Realismus beginnen mit einer Beratung, weil die Komposition vor der ersten Linie stehen muss.'],
      ['Ich komme nicht aus Berlin. Muss ich für eine Beratung nach Berlin kommen?', 'Nein. Die Beratung läuft auch per Video, direkt mit deinem Artist: Idee, Referenzen, Stelle, Größe. Die Skizze entsteht im Call. Entwurf und Festpreis stehen vor deiner Anreise. In Berlin geht deine Zeit dann in eine Sache: das Tattoo.'],
      ['Kann ich meine alten Tattoos covern lassen?', 'Oft ja. Entschieden wird am Foto oder vor Ort, nicht am Telefon. Das alte Pigment bleibt in der Haut, nur Laser löst es auf. Das neue Motiv wird deshalb um das Vorhandene herum entworfen und ist meist etwas größer als das alte. Bei sehr dunklen, dichten Tattoos ist vorher eine teilweise Laseraufhellung der bessere Weg. Das sagen wir dir in der Beratung, bevor eine Nadel ins Spiel kommt.'],
      ['Wie kann ich einen Termin für ein Tattoo buchen?', 'Zwei Wege. Piercing, Walk-in-Tattoos und Auffrischungen buchst du direkt online, mit freier Wahl von Artist und Uhrzeit. Für eigene Motive, große Projekte und Cover-ups schickst du uns zuerst deine Idee. Wir melden uns innerhalb von 24 Stunden für die Beratung. Telefon +49 30 27979327, WhatsApp +49 176 47615189.'],
      ['Wie ist die Atmosphäre in eurem Studio?', 'Ein Studio, ein Team: Neue Kantstraße 6 in Charlottenburg, seit 2020. Gesprochen wird Deutsch und Englisch. Jede Nadel ist steril und wird nur einmal verwendet. Gestochen wird erst, wenn du den Sitz des Stencils auf deiner Haut freigegeben hast. Musik läuft, gehetzt wird nicht.'],
      ['Was ist, wenn ich während des Prozesses Fragen oder Probleme mit meinem Artist habe?', 'Ab der Beratung hast du einen direkten Draht zu deinem Artist: für Fragen und für Änderungen am Entwurf, bis zum Termin. Der Entwurf wird angepasst, bis du ihn freigibst. Auch am Tag selbst sind kleine Änderungen vor der ersten Linie möglich. Wenn du lieber mit dem Studio sprichst: +49 30 27979327 oder WhatsApp, Montag bis Samstag 11 bis 19 Uhr.'],
      ['Kann ich mein Tattoo verändern oder entfernen lassen, wenn es mir nicht gefällt?', 'Entfernen lässt sich ein Tattoo nur per Laser, in mehreren Sitzungen. Verändern geht auch ohne: als Redesign, das ein bestehendes Motiv erweitert oder einbindet, oder als Cover-up, das es ersetzt. Welcher Weg auf deiner Haut funktioniert, klären wir in der Beratung am Original.'],
      ['Tut ein Tattoo weh?', 'Ja, unterschiedlich stark je nach Stelle. Rippen, Ellenbogen und Knöchel spüren die meisten deutlicher als Oberarm oder Wade. Was spürbar hilft: ausgeschlafen kommen, vorher essen, kein Alkohol. Bevor die Nadel ansetzt, sagt dir dein Artist, was du an genau dieser Stelle erwarten kannst.'],
      ['Kann ich mein eigenes Tattoo entwerfen?', 'Ja. Bring deine Zeichnung mit. Bevor sie auf die Haut geht, prüft dein Artist zwei Dinge: ob jedes Element in Originalgröße noch lesbar bleibt, und ob die Form zur gewählten Körperstelle passt. Was sich dafür ändern muss, siehst du im Entwurf. Entscheiden tust du.'],
      ['Wie pflege ich mein Tattoo nach dem Stechen richtig?', 'Die Pflegeanleitung bekommst du, bevor du das Studio verlässt. Die Grundregeln: vorsichtig mit milder Seife und lauwarmem Wasser reinigen, trocken tupfen, dünn eincremen. Zwei Wochen lang kein heißes Wasser, kein Schwimmen, keine direkte Sonne. Nicht kratzen, Schüppchen nicht abziehen. Nach der Abheilung sehen wir uns das Motiv gemeinsam an. Wo die Farbe nicht gleichmäßig angenommen wurde, wird nachgestochen. Das gehört zur Arbeit am Motiv, ohne Aufpreis.'],
      ['Ist euer Studio nur für Erwachsene?', 'Ja, du musst mindestens 18 Jahre alt sein, um ein Tattoo zu bekommen. Wenn du unter 18 bist, musst du gemeinsam mit einem Elternteil oder einer erziehungsberechtigten Person kommen. Außerdem ist eine schriftliche Einverständniserklärung erforderlich.'],
      ['Muss ich eine Anzahlung für mein Tattoo leisten?', 'Ja, ab dem Tattoo-Termin – nicht ab dem Gespräch. Beratung und erster Entwurf kosten nichts: Ein Entwurf ohne Gespräch hat keine Grundlage, deshalb steht das Gespräch am Anfang und nicht auf der Rechnung. Buchst du einen Tattoo-Termin, sichert ihn eine Anzahlung. Danach arbeitet dein Artist den finalen Entwurf aus, und diese Zeit ist für dich reserviert. Du kommst: Die volle Anzahlung wird vom Endpreis abgezogen. Du verschiebst: Sie bleibt auf deinen neuen Termin gutgeschrieben. Du erscheinst ohne Absage nicht: Sie verfällt, weil die Arbeit am Entwurf schon getan ist.'],
      // ND-134 (niloo, 2026-09-21): transparency about how the reviews on the site are chosen.
      // §5b Abs. 3 UWG requires stating whether and how reviews are checked. Do not flatten this
      // into a generic answer in any later FAQ rewrite: the sentence about not being able to
      // verify every Google account is the point. Numbers come from site.reviews, never typed.
      ['Wie wählt ihr die Bewertungen auf dieser Seite aus?', `Sie stehen alle öffentlich in unserem Google-Profil. Wir geben sie im Wortlaut wieder und kürzen nur die Länge. Eine eigene Echtheitsprüfung führen wir nicht durch — wir können nicht nachprüfen, ob hinter jedem Google-Konto ein Termin bei uns steht. Wir zeigen eine Auswahl, die die Fragen abdeckt, die uns vor einer Beratung am häufigsten gestellt werden. Der Schnitt von ${site.reviews.rating.de} aus ${site.reviews.count} Bewertungen ist der vollständige Wert, und alle Bewertungen liegen einen Klick entfernt bei Google.`, 'bewertungen-auswahl'],
    ],
  },
  en: {
    title: 'FAQ | UseeTattoo Studio – Berlin',
    description: 'Common questions about pricing, consultation, cover-ups, appointments, aftercare and deposits at Usee Tattoo Berlin.',
    h1: 'Frequently asked questions',
    items: [
      ['How much does a tattoo cost?', 'Small walk-in tattoos start at 100 €. The exact price depends on size and detail and is fixed before the needle starts. For larger pieces, the price depends on size, detail, placement and the number of sessions. That is why there is no price list for them, but a fixed price. It is set in the consultation together with the design, with a session plan for larger pieces. You know it before you confirm an appointment. Nothing is added on the day.'],
      ['Can I get a short-notice appointment?', 'Yes, for smaller pieces. We take walk-ins Monday to Saturday, 11 am to 7 pm, depending on the day, tattooed by resident artists only. We only start what can be finished in the same session, and we tell you before we say yes. Large pieces, cover-ups and realism start with a consultation, because the composition has to be settled before the first line.'],
      ["I'm not from Berlin. Do I need to travel for a consultation?", 'No. The consultation also runs by video, directly with your artist: idea, references, placement, size. The sketch is made during the call. Design and fixed price are agreed before you travel. Your time in Berlin then goes into one thing: the tattoo.'],
      ['Can I have my old tattoos covered up?', 'Often, yes. We decide from a photo or in person, not over the phone. The old pigment stays in the skin; only laser breaks it down. So the new piece is designed around what is already there and is usually a little larger than the old one. With very dark, dense tattoos, partial laser lightening first is the better route. We tell you in the consultation, before a needle is involved.'],
      ['How do I book a tattoo appointment?', 'Two ways. Piercings, walk-in tattoos and touch-ups can be booked directly online, choosing your artist and time yourself. For your own designs, large projects and cover-ups, send us your idea first. We reply within 24 hours to set up the consultation. Phone +49 30 27979327, WhatsApp +49 176 47615189.'],
      ['What is the atmosphere like in your studio?', 'One studio, one team: Neue Kantstraße 6 in Charlottenburg, since 2020. We work in German and English. Every needle is sterile and used once. Nothing is tattooed until you have approved the stencil placement on your skin. Music plays, nobody rushes.'],
      ['What if I have questions or problems with my artist during the process?', 'From the consultation on, you have a direct line to your artist: for questions and for changes to the design, right up to the appointment. The design is adjusted until you approve it. Small changes are still possible on the day, before the first line. If you would rather talk to the studio: +49 30 27979327 or WhatsApp, Monday to Saturday, 11 am to 7 pm.'],
      ['Can I have my tattoo changed or removed if I do not like it?', 'A tattoo can only be removed by laser, over several sessions. Changing it works without that: as a redesign that extends or incorporates the existing piece, or as a cover-up that replaces it. Which route works on your skin is decided in the consultation, looking at the original.'],
      ['Does getting a tattoo hurt?', 'Yes, more in some places than others. Most people feel ribs, elbows and ankles more than the upper arm or calf. What helps: come rested, eat beforehand, no alcohol. Before the needle starts, your artist tells you what to expect at exactly that spot.'],
      ['Can I design my own tattoo?', 'Yes. Bring your drawing. Before it goes on skin, your artist checks two things: whether every element stays readable at actual size, and whether the shape fits the placement you chose. Anything that needs to change for that, you see in the design. The decision is yours.'],
      ['How do I care for my tattoo properly after getting it?', "You get the aftercare instructions before you leave the studio. The basics: clean gently with mild soap and lukewarm water, pat dry, apply a thin layer of cream. For two weeks, no hot water, no swimming, no direct sun. Don't scratch and don't pick off flakes. Once it has healed, we look at the piece together. Where the ink has not settled evenly, it is touched up. That is part of the work, at no extra cost."],
      ['Is your studio adults only?', 'Yes, you must be at least 18 years old to get a tattoo. If you are under 18, you must come together with a parent or legal guardian. A written declaration of consent is also required.'],
      ['Do I need to pay a deposit for my tattoo?', "Yes, from the tattoo appointment on – not from the conversation. The consultation and the first design cost nothing: a design without a conversation has nothing to stand on, so the conversation comes first and not on the invoice. When you book a tattoo appointment, a deposit secures it. Your artist then works out the final design, and that time is reserved for you. You show up: the full deposit comes off your final price. You reschedule: it stays credited to your new date. You don't show up without notice: it is forfeited, because the work on the design is already done."],
      // ND-134 — English twin of the review-transparency answer above. Same anchor id.
      ['How do you choose the reviews on this page?', `All of them are public on our Google profile. We quote them as written and only shorten for length. We do not run our own authenticity check — we cannot verify that every Google account belongs to someone who sat in our chair. What you see is a selection covering the questions we are asked most often before a consultation. The ${site.reviews.rating.en} out of ${site.reviews.count} is the complete figure, and every review is one click away on Google.`, 'bewertungen-auswahl'],
    ],
  },
}[lang];

// FAQPage structured data (schema.org / JSON-LD) — makes the studio eligible
// for expandable FAQ rich results in Google Search and improves how AI
// search engines can read and cite our own answers.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Base lang={lang} title={faq.title} description={faq.description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <section class="detail-hero">
    <div class="wrap">
      <div class="dh-txt reveal" style="max-width:760px">
        <div class="eyebrow">FAQ</div>
        <h1>{faq.h1}</h1>
      </div>
    </div>
  </section>

  <section class="faq" style="padding-top:60px">
    <div class="wrap">
      <div class="faq-list reveal">
        {faq.items.map(([q, a, id], i) => (
          <details id={id} open={i === 0}>
            <summary><span>{q}</span><span class="plus">+</span></summary>
            <div class="ans">{a}</div>
          </details>
        ))}
      </div>
      <div class="reveal" style="text-align:center;margin-top:64px">
        <a class="cta primary" style="background:var(--ink);color:var(--paper)" href={site.booking.consultation} target="_blank" rel="noopener">{L.bookConsult}</a>
      </div>
    </div>
  </section>

  <script>
    // Deep links like /de/faq/#bewertungen-auswahl should open the answer, not just
    // scroll to a collapsed <details>. Runs on load and on every later hash change.
    function openHashTarget() {
      const hash = window.location.hash;
      if (!hash || hash.length < 2) return;
      let el = null;
      try { el = document.querySelector(hash); } catch (e) { return; }
      if (el && el.tagName === 'DETAILS') {
        el.open = true;
        el.scrollIntoView({ block: 'start' });
      }
    }
    openHashTarget();
    window.addEventListener('hashchange', openHashTarget);
  </script>
</Base>
