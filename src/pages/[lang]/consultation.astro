---
import Base from '../../layouts/Base.astro';
import { langs } from '../../data/i18n.js';
import { site } from '../../data/site.js';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const img = '/images/consultation/Consultation.webp';

const c = {
  de: {
    title: 'Tattoo-Beratung | UseeTattoo Studio – Berlin',
    description: 'Große Tattoos beginnen mit einer kostenlosen Beratung. Persönlich oder online: Dein Artist gestaltet das Motiv für deinen Körper, deine Geschichte und deine Zukunft.',
    eyebrow: '/ Tattoo-Beratung',
    h1: 'Dein Projekt verdient einen Plan, keine Preisliste',
    lead: 'Große Tattoos, ganze Sleeves, Black-&-Grey-Realismus, Micro-Realismus, Maori, werden nicht online gebucht. Sie beginnen mit einer kostenlosen Beratung, in der dein Artist das Motiv rund um deinen Körper, deine Geschichte und deine Zukunft entwirft.',
    ctaBook: 'Beratung buchen', ctaOnline: 'Online-Beratung',
    quickQ: 'Erst eine kurze Frage?', whatsapp: 'Schreib uns per WhatsApp.',
    s1Title: 'Warum wir große Projekte nicht einfach „buchen"',
    s1: [
      'Ein Tattoo, das du dein Leben lang trägst, muss gestaltet werden, für deine Anatomie, nicht nur für deine Idee.',
      'Unsere Artists bauen jedes große Stück auf dieselbe Weise auf: zuerst deine Idee verstehen, dann formen, wie die Elemente, Linie, Schattierung, Fluss, Komposition, zu einem Design zusammenkommen, das für deinen Körper gemacht ist, nicht aus einer Vorlage vergrößert.',
      'Deshalb kommt die Beratung zuerst. Sie ist kostenlos, kein Verkaufsgespräch, und endet mit einem Plan, zu dem du wirklich Ja oder Nein sagen kannst.',
    ],
    leaveTitle: 'Was du mitnimmst',
    leaveLead: 'Am Ende deiner Beratung hast du:',
    leave: [
      'Eine klare kreative Richtung für dein Tattoo',
      'Einen Gestaltungsansatz, gebaut um deine Anatomie und Platzierung',
      'Eine Live-Skizze, gemeinsam mit dir begonnen, nicht später zugeschickt',
      'Einen klaren Preisrahmen',
      'Eine geschätzte Anzahl an Sitzungen',
      'Einen direkten Draht zu deinem Artist für alles Weitere',
    ],
    leaveNote: 'Nichts davon ist vage. Du gehst mit etwas Konkretem, ob du am selben Tag buchst oder dir Zeit zum Nachdenken nimmst.',
    howTitle: 'Wie dein Design tatsächlich entsteht',
    how: [
      ['Wir hören zuerst zu', 'Dein Artist fragt nach der Idee, was sie dir bedeutet und was dich zögern lässt. Gutes Design beginnt mit Verständnis.'],
      ['Deine Geschichte formt das Konzept', 'Je mehr dein Artist weiß, die Details, die Bedeutung, die Zweifel, desto persönlicher fühlt sich das finale Design an.'],
      ['Elemente werden komponiert, nicht kopiert', 'Linie, Schattierung und Fluss werden zu einem Design angeordnet, das für deinen Körper gebaut ist.'],
      ['Eine Live-Skizze, direkt vor dir', 'Dein Artist skizziert während der Beratung selbst, im Raum oder im Call, sodass du das Denken siehst, während es entsteht.'],
      ['Klarer Preis und Sitzungsplan', 'Ein echtes Angebot auf Basis von Größe, Detailgrad und der Anzahl der nötigen Sitzungen.'],
    ],
    howNote: 'Das ist im kostenlosen Beratungsgespräch enthalten. Nichts am Gestaltungsprozess wird separat berechnet, die Anzahlung später sichert nur deinen Tattoo-Termin.',
    unsureTitle: 'Noch unsicher? Genau dafür ist die Beratung da',
    unsure: [
      'Unsicher über Design, Größe, ob zwei Stile zusammenpassen oder ob es sich in zehn Jahren noch nach dir anfühlt? Alles normal, und nichts davon muss vor der Buchung geklärt sein.',
      'Nichts wird in einer Sitzung entschieden, und nichts ist final, bevor du überzeugt bist. Wenn die erste Richtung nicht ganz passt, sagst du es, das ist Teil des Prozesses, keine Komplikation.',
    ],
    travelTitle: 'Reist du für dein Tattoo nach Berlin? Beginne das Design vor der Ankunft',
    travel: [
      'Die meisten unserer Kund:innen kommen nicht aus Berlin. Sie reisen gezielt an, um von einem Usee-Artist tätowiert zu werden, und für ein erstes Gespräch anzureisen wäre Verschwendung.',
      'Die Online-Beratung löst das. Du sprichst per Video direkt mit deinem Artist, arbeitest die Idee und das Design gemeinsam durch und kommst mit allem bereits geplant an. In Berlin geht deine Zeit dann in eine Sache: tätowiert werden.',
      'Sie verschafft dir außerdem etwas Wertvolleres als Zeit: Abstand zur Entscheidung. Dein Design entsteht über Calls in den Wochen vor deiner Reise, sodass du mit dem Konzept leben und bis zum Termin Änderungen wünschen kannst.',
    ],
    relTitle: 'Eine Beziehung, von der ersten Skizze bis zur letzten Sitzung',
    rel: [
      'Ob du persönlich oder online startest, du bleibst in direktem Kontakt mit deinem Artist und verfeinerst das Design gemeinsam bis zum Tattoo-Tag. Nichts ist in dem Moment festgelegt, in dem du die Beratung verlässt.',
      'Einem Design Raum zur Entwicklung zu geben, und offen für den Input deines Artists zu bleiben, führt meist zu einem durchdachteren Ergebnis als etwas, das spontan festgelegt wird.',
    ],
    prepTitle: 'So holst du das Meiste aus deiner Beratung',
    prepLead: 'Ein wenig Vorbereitung macht deine erste Skizze schärfer, noch bevor du dich hinsetzt:',
    prep: [
      ['Schreib auf, was in deinem Kopf ist', 'auch grob. Die Idee, das Gefühl, warum es dir wichtig ist.'],
      ['Sende Referenzfotos', 'von allem, das deiner Vorstellung nahekommt, Stil, Platzierung, ähnliche Stücke, die dir gefallen.'],
    ],
    prepNote: 'Und wenn ihr sprecht, sag alles. Die Details, die du zögerst zu erwähnen, machen ein Design oft persönlich statt generisch. Dieses Tattoo bleibt bei dir, dein Artist kann nur etwas bauen, das wirklich zu dir passt, wenn er dich kennt.',
    artistTitle: 'Nicht sicher, welcher Artist zu deinem Projekt passt?',
    artistLead: 'Realismus, Black & Grey, Micro-Realismus, Maori: Wenn du unsicher bist, wer der richtige Match ist, sag uns, was dir vorschwebt, und wir weisen dir den Artist zu, dessen Stil und Erfahrung am besten passen.',
    artists: [
      ['Realistic & Black and Grey', 'Josef.'],
     ['Micro Realism', 'Cali, mit JVD im Fokus auf Fine Line.'],
      ['Maori', 'Josef, freihändig, direkt für deinen Körper komponiert statt vorgezeichnet.'],
      ['Ganze & halbe Sleeves, große Cover-ups, Multi-Session-Projekte', 'nach Stil und Umfang zugeordnet.'],
    ],
    depositTitle: 'Zur Anzahlung',
    depositIntro: 'Beratung und Designarbeit sind kostenlos. Sobald du und dein Artist euch auf Design und Preis geeinigt habt, sichert eine Anzahlung deinen Tattoo-Termin, das ist der einzige Punkt, an dem Geld ins Spiel kommt.',
    deposit: [
      ['Du kommst', 'die volle Anzahlung wird von deinem Endpreis abgezogen.'],
      ['Du verschiebst', 'sie bleibt vollständig auf deinen neuen Termin gutgeschrieben, kein Verlust.'],
      ['Du erscheinst nicht ohne Absage', 'sie verfällt, da dein Artist bereits echte Zeit in dein Design gesteckt hat.'],
    ],
    depositNote: 'Wenn deine Idee über deinem geplanten Budget liegt, ist das ein normaler Teil des Gesprächs, wir schauen, was sich realistisch anpassen lässt (Größe, Detail, Anzahl der Sitzungen), ohne das Stück zu kompromittieren.',
    faqTitle: 'Häufige Fragen',
    faq: [
      ['Ist die Beratung wirklich kostenlos?', 'Ja, inklusive der ersten Skizze und Design-Richtung. Es gibt keine separate Designgebühr und keine Verpflichtung, danach zu buchen.'],
      ['Ich bin nicht in Berlin, muss ich für die Beratung anreisen?', 'Nein. Die Online-Beratung deckt dasselbe ab wie die persönliche, deshalb reisen die meisten internationalen Kund:innen nur für die Tattoo-Session an.'],
      ['Bekomme ich in der Beratung einen Preis?', 'Ja. Du gehst mit einem klaren Angebot auf Basis von Größe, Detail und Anzahl der Sitzungen.'],
      ['Kann ich mein Design nach der Beratung noch ändern?', 'Ja. Du arbeitest bis zu deinem Tattoo-Tag mit deinem Artist weiter.'],
      ['Was, wenn ich mir bei Idee oder Artist noch unsicher bin?', 'Bring Referenzen oder auch nur ein grobes Gefühl mit, das Konzept zu formen und dich dem richtigen Artist zuzuordnen, ist beides Teil der Beratung.'],
      ['Ich bin nervös, mich auf etwas Dauerhaftes festzulegen, ist das normal?', 'Völlig. Nichts wird in einem Schritt final, und du bleibst bis zum Tag des Tattoos in direktem Kontakt mit deinem Artist.'],
    ],
    ctaTitle: 'Bring deine Idee zu den Menschen, die dafür ausgebildet sind, sie zu gestalten, für deinen Körper und für die lange Sicht.',
  },
  en: {
    title: 'Tattoo Consultation | UseeTattoo Studio – Berlin',
    description: 'Large tattoos start with a free consultation. In person or online, your artist designs the piece around your body, your story and your future.',
    eyebrow: '/ Tattoo Consultation',
    h1: 'Your project deserves a plan, not a price list',
    lead: "Large-scale tattoos, full sleeves, black & grey realism, micro-realism, Maori work, aren't booked online. They start with a free consultation, where your artist designs the piece around your body, your story, and your future.",
    ctaBook: 'Book a consultation', ctaOnline: 'Online consultation',
    quickQ: 'Have a quick question first?', whatsapp: 'WhatsApp us.',
    s1Title: 'Why we don\'t just "book" large projects',
    s1: [
      "A tattoo you'll wear for the rest of your life needs to be designed, for your anatomy, not just your idea.",
      'Our artists build every large piece the same way: understanding your idea first, then shaping how the elements, line, shading, flow, composition, come together into one design made for your specific body, not resized from a reference photo.',
      "That's why the consultation comes first. It's free, it's not a sales pitch, and it ends with a plan you can actually say yes or no to.",
    ],
    leaveTitle: 'What you leave with',
    leaveLead: "By the end of your consultation, you'll have:",
    leave: [
      'A clear creative direction for your tattoo',
      'A design approach built around your anatomy and placement',
      'A live sketch, started with you, not sent to you later',
      'A clear price estimate',
      'An estimated number of sessions',
      'A direct line to your artist going forward',
    ],
    leaveNote: 'Nothing here is vague. You leave with something concrete, whether you book that day or take time to think.',
    howTitle: 'How your design actually gets made',
    how: [
      ['We listen first', 'Your artist asks about the idea, what it means to you, and what is making you hesitate. Good design starts with understanding.'],
      ['Your story shapes the concept', 'The more your artist knows, the details, the meaning, the doubts, the more personal the final design feels.'],
      ['Elements get composed, not copied', 'Line, shading, and flow are arranged into one design built for how it will sit on your body.'],
      ['A live sketch, in front of you', 'Your artist sketches during the consultation itself, in the room or on the call, so you see the thinking as it happens.'],
      ['Clear pricing and a session plan', 'A real quote based on size, detail, and how many sittings the piece needs.'],
    ],
    howNote: "This is what's included in the free consultation. Nothing about the design process is billed separately, the deposit later only secures your tattoo session.",
    unsureTitle: "Not sure yet? That's exactly what the consultation is for",
    unsure: [
      "Unsure about the design, the size, whether two styles you like will even work together, or whether it'll still feel like you in ten years? All normal, and none of it needs to be settled before you book.",
      "Nothing is decided in one sitting, and nothing is finalized until you're confident in it. If the first direction isn't quite right, you say so, that's part of the process, not a complication.",
    ],
    travelTitle: 'Traveling to Berlin for your tattoo? Start the design before you land',
    travel: [
      'Most of our clients aren\'t from Berlin. They fly in specifically to be tattooed by a Usee artist, and flying in for a first conversation is a waste of a trip.',
      'The online consultation solves that. You speak directly with your artist by video, work through the idea and design together, and arrive with everything already planned. When you land in Berlin, your time goes into one thing: getting tattooed.',
      'It also buys you something more valuable than time: distance from the decision. Your design takes shape over calls in the weeks before your trip, giving you room to live with the concept and ask for changes right up until your appointment.',
    ],
    relTitle: 'One relationship, from first sketch to final session',
    rel: [
      'Whether you start in person or online, you stay in direct contact with your artist and keep refining the design together until your tattoo day. Nothing is locked in the moment you leave the consultation.',
      "Giving a design room to develop, and staying open to your artist's input along the way, usually leads to a more considered result than one finalized on the spot.",
    ],
    prepTitle: 'Getting the most out of your consultation',
    prepLead: 'A little preparation makes your first sketch sharper before you even sit down:',
    prep: [
      ["Write down what's in your head", 'even loosely. The idea, the feeling, why it matters to you.'],
      ['Send reference photos', "of anything close to what you're picturing, style, placement, similar pieces you like."],
    ],
    prepNote: "And once you're talking, say everything. The details you hesitate to mention are usually the ones that make the design personal instead of generic. This tattoo stays with you; your artist can only build something that truly fits you if they actually know you.",
    artistTitle: 'Not sure which artist fits your project?',
    artistLead: "Realism, black & grey, micro-realism, Maori: if you're not sure who's the right match, tell us what you're picturing and we'll point you to the artist whose style and experience best fit the work.",
    artists: [
      ['Realistic & Black and Grey', 'Josef.'],
          ['Micro Realism', 'Cali, with JVD focused on fine line.'],
      ['Maori', 'Josef, free-hand, composed directly for your body rather than pre-drawn.'],
      ['Full and half sleeves, large cover-ups, multi-session pieces', 'matched by style and scope.'],
    ],
    depositTitle: 'About the deposit',
    depositIntro: 'The consultation and design work are free. Once you and your artist agree on the design and quote, a deposit secures your tattoo session, that is the only point money enters the process.',
    deposit: [
      ['You show up', 'the full deposit comes off your final price.'],
      ['You reschedule', 'it stays fully credited to your new date, no loss.'],
      ['You no-show without notice', 'it is forfeited, since your artist has already put real time into designing your piece.'],
    ],
    depositNote: "If your idea comes in above what you'd planned to spend, that's a normal part of the conversation, we'll look at what can realistically flex (size, detail, number of sessions) without compromising the piece.",
    faqTitle: 'Common questions',
    faq: [
      ['Is the consultation really free?', 'Yes, including the initial sketch and design direction. There is no separate design fee and no obligation to book afterward.'],
      ['I am not in Berlin, do I need to travel for the consultation?', 'No. The online consultation covers the same ground as the in-person one, so most international clients only travel for the tattoo session itself.'],
      ['Will I get a price during the consultation?', "Yes. You'll leave with a clear quote based on size, detail, and how many sessions the piece needs."],
      ['Can I still change my design after the consultation?', "Yes. You'll keep working with your artist right up until your tattoo day."],
      ['What if I am not sure about my idea yet, or which artist is right for me?', 'Bring references or even a rough feeling for the piece, shaping the concept and matching you to the right artist are both part of the consultation.'],
      ['I am nervous about committing to something permanent, is that normal?', 'Completely. Nothing is finalized in one step, and you stay in direct contact with your artist until the day of the tattoo.'],
    ],
    ctaTitle: 'Bring your idea to the people trained to design it, for your body, and for the long run.',
  },
}[lang];
---
<Base lang={lang} title={c.title} description={c.description} ogImage={img}>
  <section class="detail-hero cs-hero">
    <div class="wrap">
      <div class="cs-hero-grid">
        <div class="dh-txt reveal">
          <div class="eyebrow">{c.eyebrow}</div>
          <h1>{c.h1}</h1>
          <p class="cs-lead">{c.lead}</p>
          <div class="cta-row">
            <a class="cta primary" style="background:var(--ink);color:var(--paper)" href={site.booking.consultation} target="_blank" rel="noopener">{c.ctaBook}</a>
            <a class="cta ghost" style="border-color:var(--ink);color:var(--ink)" href={site.booking.online} target="_blank" rel="noopener">{c.ctaOnline}</a>
          </div>
          <p class="cs-whats">{c.quickQ} <a href={site.whatsapp} target="_blank" rel="noopener">{c.whatsapp}</a></p>
        </div>
        <div class="cs-hero-img reveal"><img src={img} alt="Tattoo consultation at Usee Tattoo Berlin" /></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap cs-split">
      <div class="reveal">
        <h2 class="cs-h2">{c.s1Title}</h2>
        {c.s1.map((p) => <p class="cs-p">{p}</p>)}
      </div>
      <div class="reveal cs-leave">
        <h3 class="cs-h3">{c.leaveTitle}</h3>
        <p class="cs-p">{c.leaveLead}</p>
        <ul class="cs-check">{c.leave.map((x) => <li>{x}</li>)}</ul>
        <p class="cs-note">{c.leaveNote}</p>
      </div>
    </div>
  </section>

  <section class="artists" style="padding:90px 0">
    <div class="wrap">
      <h2 class="cs-h2 reveal" style="margin-bottom:44px">{c.howTitle}</h2>
      <div class="cs-steps reveal">
        {c.how.map(([t, d], i) => (
          <div class="cs-step"><span class="n">{String(i + 1).padStart(2, '0')}</span><h4>{t}</h4><p>{d}</p></div>
        ))}
      </div>
      <p class="cs-note reveal" style="margin-top:34px">{c.howNote}</p>
    </div>
  </section>

  <section>
    <div class="wrap cs-narrow">
      <h2 class="cs-h2 reveal">{c.unsureTitle}</h2>
      {c.unsure.map((p) => <p class="cs-p reveal">{p}</p>)}
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap cs-split">
      <div class="reveal">
        <h2 class="cs-h2">{c.travelTitle}</h2>
        {c.travel.map((p) => <p class="cs-p">{p}</p>)}
      </div>
      <div class="reveal">
        <h2 class="cs-h2">{c.relTitle}</h2>
        {c.rel.map((p) => <p class="cs-p">{p}</p>)}
      </div>
    </div>
  </section>

  <section class="artists" style="padding:90px 0">
    <div class="wrap cs-split">
      <div class="reveal">
        <h2 class="cs-h2">{c.prepTitle}</h2>
        <p class="cs-p">{c.prepLead}</p>
        <ul class="cs-prep">{c.prep.map(([t, d]) => <li><strong>{t}</strong> {d}</li>)}</ul>
        <p class="cs-note">{c.prepNote}</p>
      </div>
      <div class="reveal">
        <h2 class="cs-h2">{c.artistTitle}</h2>
        <p class="cs-p">{c.artistLead}</p>
        <ul class="cs-match">{c.artists.map(([t, d]) => <li><strong>{t}</strong> {d}</li>)}</ul>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap cs-narrow">
      <h2 class="cs-h2 reveal">{c.depositTitle}</h2>
      <p class="cs-p reveal">{c.depositIntro}</p>
      <ul class="cs-prep reveal">{c.deposit.map(([t, d]) => <li><strong>{t}:</strong> {d}</li>)}</ul>
      <p class="cs-note reveal">{c.depositNote}</p>
    </div>
  </section>

  <section class="faq" style="padding-top:20px">
    <div class="wrap">
      <div class="sec-head reveal"><span class="idx">FAQ</span><h2>{c.faqTitle}</h2></div>
      <div class="faq-list acc-single reveal">
        {c.faq.map(([q, a], i) => (
          <details open={i === 0}>
            <summary><span>{q}</span><span class="plus">+</span></summary>
            <div class="ans">{a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="visit">
    <div class="wrap cs-final reveal">
      <h2 class="cs-h2" style="max-width:760px;margin:0 auto 30px">{c.ctaTitle}</h2>
      <div class="cta-row" style="justify-content:center">
        <a class="cta primary" style="background:var(--ink);color:var(--paper)" href={site.booking.consultation} target="_blank" rel="noopener">{c.ctaBook}</a>
        <a class="cta ghost" style="border-color:var(--ink);color:var(--ink)" href={site.booking.online} target="_blank" rel="noopener">{c.ctaOnline}</a>
      </div>
      <p class="cs-whats" style="text-align:center">{c.quickQ} <a href={site.whatsapp} target="_blank" rel="noopener">{c.whatsapp}</a></p>
    </div>
  </section>

  <style>
    .cs-hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center}
    .cs-hero-img{aspect-ratio:4/5;overflow:hidden;background:var(--paper-2)}
    .cs-hero-img img{width:100%;height:100%;object-fit:cover}
    .cs-lead{color:var(--ink-soft);font-size:18px;line-height:1.8;max-width:560px;margin:6px 0 26px}
    .cs-whats{font-size:14px;color:var(--ink-soft);margin-top:18px}
    .cs-whats a{color:var(--bronze-dk);text-decoration:underline;text-underline-offset:2px}
    .cs-split{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}
    .cs-narrow{max-width:820px}
    .cs-h2{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(26px,3.6vw,40px);line-height:1.15;margin:0 0 22px}
    .cs-h3{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:24px;margin:0 0 14px}
    .cs-p{color:var(--ink-soft);font-size:16px;line-height:1.85;margin-bottom:16px;max-width:640px}
    .cs-note{color:var(--bronze-dk);font-style:italic;font-family:'Cormorant Garamond',serif;font-size:19px;line-height:1.5;margin-top:24px;max-width:680px}
    .cs-leave{border:1px solid var(--line);padding:34px;background:var(--paper)}
    .cs-check{list-style:none;margin:6px 0 0}
    .cs-check li{position:relative;padding:9px 0 9px 26px;color:var(--ink-soft);font-size:15px;border-bottom:1px solid rgba(216,210,198,.5)}
    .cs-check li::before{content:"✓";position:absolute;left:0;color:var(--bronze);font-weight:600}
    .cs-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
    .cs-step{background:var(--paper-2);padding:28px 20px}
    .cs-step .n{font-family:'Cormorant Garamond',serif;font-size:30px;color:var(--bronze)}
    .cs-step h4{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:19px;margin:8px 0 10px;line-height:1.2}
    .cs-step p{color:var(--ink-soft);font-size:13.5px;line-height:1.65}
    .cs-prep,.cs-match{list-style:none;margin:6px 0 0}
    .cs-prep li,.cs-match li{padding:11px 0;color:var(--ink-soft);font-size:15px;line-height:1.7;border-bottom:1px solid rgba(216,210,198,.5)}
    .cs-prep li strong,.cs-match li strong{color:var(--ink);font-weight:600}
    .cs-final{text-align:center;padding:20px 0}
    @media(max-width:900px){
      .cs-hero-grid{grid-template-columns:1fr;gap:34px}
      .cs-hero-img{aspect-ratio:16/10;max-height:420px}
      .cs-split{grid-template-columns:1fr;gap:40px}
      .cs-steps{grid-template-columns:1fr 1fr}
    }
    @media(max-width:560px){.cs-steps{grid-template-columns:1fr}}
  </style>
</Base>
