---
import Base from '../../layouts/Base.astro';
import { t, langs } from '../../data/i18n.js';
import { site } from '../../data/site.js';
import { artists } from '../../data/artists.js';
import { styles } from '../../data/styles.js';
import { gallery } from '../../lib/gallery.js';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const L = t[lang];
const base = `/${lang}`;

// One example image per style for the homepage curtain tiles.
const styleImg = Object.fromEntries(
  styles.map((s) => [s.slug, gallery(`/images/TattooStyle/${s.folder}`, { exclude: ['Highlight'] })[0] || site.heroImage])
);

const title = lang === 'de'
  ? 'Bestes Tattoo Studio in Berlin | UseeTattoo Studio'
  : 'Best Tattoo Studio in Berlin | UseeTattoo Studio';
const description = lang === 'de'
  ? 'Usee Tattoo in Berlin ist mehr als ein Tattoo Studio. Ein Team aus qualifizierten Artists in Charlottenburg, Custom Tattoos nach persönlicher Beratung.'
  : 'UseeTattoo in Berlin is not just a tattoo studio! Our team consists only of qualified artists. Custom tattoos by private consultation, Charlottenburg.';

const homeGallery = [
  '/images/home/selected/SelectedWorks_1.webp',
  '/images/home/selected/SelectedWorks_2.webp',
  '/images/home/selected/SelectedWorks_3.webp',
  '/images/home/selected/SelectedWorks_4.webp',
  '/images/home/selected/SelectedWorks_5.webp',
  '/images/home/selected/SelectedWorks_6.webp',
  '/images/home/selected/SelectedWorks_7.webp',
  '/images/home/selected/SelectedWorks_8.webp',
];
---
<Base lang={lang} title={title} description={description}>
  <!-- HERO -->
  <section class="hero" style={`--hero:url('${site.heroImage}')`}>
    <div class="hero-inner">
      <div class="kicker">{L.kicker}</div>
      <h1 set:html={L.heroTitle}></h1>
      <p class="lede">{L.heroLede}</p>
      <div class="hero-cta hero-booking">
        {site.bookingServices.map((s, i) => (
          <a class={`cta ${i === 0 ? 'primary' : 'ghost'}`} href={s.url} target="_blank" rel="noopener">{s[lang]}</a>
        ))}
      </div>
    </div>
    <a class="scrolldown" href={`${base}/#studio`}>{L.discover}<span class="line"></span></a>
  </section>

  <!-- STATEMENT -->
  <section class="statement wrap reveal" id="studio">
    <div class="eyebrow">{L.statementEyebrow}</div>
    <p set:html={L.statement}></p>
  </section>

  <!-- ARTISTS -->
  <section class="artists" id="artists">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="idx">01</span>
        <h2>{L.artistsTitle}</h2>
        <a href={`${base}/#artists`}>{L.viewAll}</a>
      </div>
      <div class="artist-grid reveal">
        {artists.map((a) => (
          <a class="artist" href={a.built ? `${base}/artists/${a.slug}` : `${base}/#artists`}>
            <div class="ph"><img src={a.portrait} alt={a.name} loading="lazy" /></div>
            <h3>{a.name}</h3>
            <div class="spec">{a.specialties[lang]}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STYLES -->
  <section id="styles">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="idx">02</span>
        <h2>{L.stylesTitle}</h2>
        <a href={`${base}/#styles`}>{L.allStyles}</a>
      </div>
      <div class="style-grid reveal">
        {styles.map((s, i) => (
          <a class="style-tile" href={`${base}/styles/${s.slug}`}>
            <img class="style-img" src={styleImg[s.slug]} alt={s.name[lang]} loading="lazy" />
            <div class="curtain c-l"></div>
            <div class="curtain c-r"></div>
            <div class="style-label">
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.name[lang]}</h3>
              <p class="style-desc">{s.tagline[lang]}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="gallery">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="idx">03</span>
        <h2>{L.workTitle}</h2>
        <a href={site.social.instagram} target="_blank" rel="noopener">@usee.tattoo →</a>
      </div>
      <div class="g-grid reveal">
        {homeGallery.map((src) => (
          <div class="cell"><img src={src} alt="" loading="lazy" /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- WALK-IN -->
  <section id="walkin">
    <div class="wrap">
      <div class="events-row home-ev-row reveal">
        <div class="txt">
          <div class="eyebrow">{L.walkinEyebrow}</div>
          <h2 set:html={L.walkinTitle}></h2>
          <p>{L.walkinText}</p>
          <div class="cta-row" style="align-items:center;gap:24px;flex-wrap:wrap">
            <a class="cta primary" style="background:var(--ink);color:var(--paper)" href={site.booking.walkin} target="_blank" rel="noopener">{L.walkinBtn}</a>
            <a class="link-underline" href={`${base}/walk-in`}>{L.walkinMore}</a>
          </div>
        </div>
        <div class="ph"><img src="/images/walkin/Hero.webp" alt="Walk-in tattoo" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- COVER-UP -->
  <section id="coverup" class="artists">
    <div class="wrap">
      <div class="events-row cu-home-row reveal">
        <div class="ph" style="filter:grayscale(1) contrast(1.02)"><img src="/images/coverup/coverup_2.webp" alt="Cover-up work" loading="lazy" /></div>
        <div class="txt">
          <div class="eyebrow">Cover-Up Center</div>
          <h2>{lang === 'de' ? 'Aus alt wird neue Kunst' : 'Turn old ink into new art'}</h2>
          <p>{lang === 'de'
            ? 'Dein altes Tattoo muss kein Makel bleiben. Wir verwandeln es in ein völlig neues Kunstwerk, geplant für deine Haut und geschaffen, um mit Stolz getragen zu werden. Cover-Up ist eines der anspruchsvollsten Spezialgebiete im Tattoo, und eines unserer. Jeder Fall wird individuell bewertet, manchmal ist eine teilweise Laseraufhellung oder eine Neugestaltung der klügere erste Schritt. Sende uns ein Foto und entdecke, was möglich ist.'
            : "That old tattoo doesn't have to stay a regret. We reimagine it as a bold new piece, designed around your skin and made to be worn with pride. Cover-up is one of the most demanding specialties in tattooing, and one of ours. Every case is assessed individually, and sometimes partial laser lightening or a redesign is the smarter first step. Send us a photo and see what's possible."}</p>
          <a class="link-underline" href={`${base}/cover-up`}>{lang === 'de' ? 'Zum Cover-Up Center →' : 'Visit the Cover-Up Center →'}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PIERCING -->
  <section id="piercing-home" class="artists">
    <div class="wrap">
      <div class="events-row home-ev-row reveal">
        <div class="txt">
          <div class="eyebrow">{L.piercingEyebrow}</div>
          <h2 set:html={L.piercingTitle}></h2>
          <p>{L.piercingText}</p>
          <div class="cta-row" style="align-items:center;gap:24px;flex-wrap:wrap">
            <a class="cta primary" style="background:var(--ink);color:var(--paper)" href={site.booking.piercing} target="_blank" rel="noopener">{L.piercingBtn}</a>
            <a class="link-underline" href={`${base}/piercing`}>{L.piercingMore}</a>
          </div>
        </div>
        <div class="ph"><img src="/images/piercing/gallery/Piercing_6.webp" alt="Piercing at Usee Tattoo" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- EVENTS / GUEST -->
  <section id="events">
    <div class="wrap">
      <div class="events-row home-ev-row reveal">
        <div class="txt">
          <div class="eyebrow">{L.eventsEyebrow}</div>
          <h2 set:html={L.eventsTitle}></h2>
          <p>{L.eventsText}</p>
          <a class="link-underline" href={`${base}/events/guest-artists`}>{L.eventsLink}</a>
        </div>
        <div class="ph"><img src="/images/past_events/opening/Opening_6.webp" alt="Guest artist tattooing at Usee Tattoo" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="idx">04</span>
        <h2>{L.faqTitle}</h2>
        <a href={`${base}/faq`}>{L.allQuestions}</a>
      </div>
      <div class="faq-list reveal">
        {L.faqItems.map((f, i) => (
          <details open={i === 0}>
            <summary><span>{f.q}</span><span class="plus">+</span></summary>
            <div class="ans">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- VISIT -->
  <section class="visit" id="visit">
    <div class="wrap visit-grid">
      <div class="reveal">
        <div class="eyebrow">{L.visitEyebrow}</div>
        <h2 set:html={L.visitTitle}></h2>
        <div class="cta-row">
          <a class="cta primary" style="background:var(--ink);color:var(--paper)" href={site.booking.consultation} target="_blank" rel="noopener">{L.bookConsult}</a>
          <a class="cta ghost" style="border-color:var(--ink);color:var(--ink)" href={site.phone.href}>{L.call}</a>
        </div>
      </div>
      <div class="reveal">
        <div class="detail"><div class="k">{L.labelAddress}</div><div class="v">{site.address.street}<br />{site.address.zip} {site.address.city} · {site.address.district}</div></div>
        <div class="detail"><div class="k">{L.labelHours}</div><div class="v" set:html={L.hours}></div></div>
        <div class="detail"><div class="k">{L.labelPhone}</div><div class="v"><a href={site.phone.href}>{site.phone.display}</a></div></div>
        <div class="detail"><div class="k">E-Mail</div><div class="v"><a href={`mailto:${site.email.primary}`}>{site.email.primary}</a></div></div>
      </div>
    </div>
    <div class="wrap" style="margin-top:64px">
      <div class="map reveal">
        <iframe loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Usee Tattoo, Neue Kantstraße 6, Berlin"
          src={`https://www.google.com/maps?q=${site.mapQuery}&output=embed`}></iframe>
      </div>
    </div>
  </section>
</Base>
