---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';

const title = 'Seite nicht gefunden · Page not found | UseeTattoo Studio – Berlin';
const description = 'Diese Seite existiert nicht mehr. This page no longer exists. Zur Startseite von Usee Tattoo Berlin-Charlottenburg.';
---
<Base lang="de" title={title} description={description}>
  <section class="detail-hero legal-page">
    <div class="wrap">
      <div class="legal-wrap reveal" style="text-align:center">
        <div class="eyebrow">404</div>
        <h1>Diese Seite gibt es nicht mehr</h1>
        <p class="lg-lead">
          Der Link ist veraltet oder die Seite wurde verschoben. Vielleicht findest du,
          wonach du suchst, auf unserer Startseite – oder wir sehen uns bald im Studio.
        </p>
        <p style="opacity:.65;margin-top:-6px">
          This page no longer exists or has moved. Maybe our homepage has what you were
          looking for – or we will see you at the studio soon.
        </p>

        <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin:36px 0 8px">
          <a href="/de/" style="font-family:'Inter',sans-serif;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:14px 26px;background:var(--ink);color:var(--paper);text-decoration:none">
            Zur Startseite
          </a>
          <a href="/en/" style="font-family:'Inter',sans-serif;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:14px 26px;border:1px solid var(--ink);color:var(--ink);text-decoration:none">
            Homepage (EN)
          </a>
        </div>
        <p style="margin-top:28px">
          <a href="/de/contact">Kontakt</a> &middot;
          <a href={site.phone.href}>{site.phone.display}</a> &middot;
          <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        </p>
      </div>
    </div>
  </section>
</Base>
