---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { site } from '../data/site.js';

// Standalone bilingual (DE + EN) page for BIKE DAYS BERLIN 2026.
// URL stays exactly /bikedays (printed QR codes point here) and is never deleted (ND-457).
// From 30 Nov 2026 it is the "Danke" (thank-you) version: aftercare, consultation for
// bigger ideas, the BIKEDAYS studio code and the studio address. Text: ND-457 v1 (Assistant).
// It does NOT use the site Base layout (no global form / cookie chrome).

const STUDIO = 'https://book.useetattoo.com/Consultation'; // studio booking (302 -> Fresha lid=1467911, Studio Neue Kantstraße 6)
const MAPS = 'https://www.google.com/maps/search/?api=1&query=Usee+Tattoo+Neue+Kantstra%C3%9Fe+6+14057+Berlin';

const title = 'Danke, BIKE DAYS BERLIN 2026 | Usee Tattoo Charlottenburg';
const description = 'Danke für drei Tage an Stand 208. Pflegeanleitung für dein Stand-Tattoo, Beratung für größere Ideen und dein Code BIKEDAYS bis 31.01.2027.';
const og = site.domain + '/images/bikedays/bikedays-hero.webp';
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/images/brand/LOGO_black_TransparentBG.png" />
  <link rel="apple-touch-icon" href="/images/brand/LOGO_white_TransparentBG.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site.domain + '/bikedays/'} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Usee Tattoo" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body>
{/* Main site header/menu, added so visitors can navigate the rest of the site */}
<Header lang="de" altPath="/en/" altLabel="EN" />
<div class="backdrop" id="backdrop"></div>
<div class="bd-page">

  <!-- ================= HERO ================= -->
  <div class="bd-hero">
    <img class="bd-hero-img" src="/images/bikedays/bikedays-hero.webp"
         srcset="/images/bikedays/bikedays-hero-sm.webp 1200w, /images/bikedays/bikedays-hero.webp 1920w"
         sizes="100vw" alt="Usee Tattoo Artist bei der Arbeit im Studio" />
    <div class="bd-hero-shade"></div>
    <div class="wrap bd-hero-inner">
      <div class="bd-lockup">
        <img class="bd-logo-usee" src="/images/brand/LOGO_white_TransparentBG.png" alt="Usee Tattoo" />
        <span class="bd-x">×</span>
        <img class="bd-logo-bd" src="/images/bikedays/bikedays-logo.webp" alt="BIKE DAYS BERLIN" />
      </div>

      <span class="bd-badge">
        BIKE DAYS BERLIN 2026 · Danke
        <em>BIKE DAYS BERLIN 2026 · Thank you</em>
      </span>

      <h1 class="bd-h1">
        Danke für drei Tage in Halle 26c
        <span>Thank you for three days in Hall 26c</span>
      </h1>

      <p class="bd-sub">
        27.–29. November 2026 · Messe Berlin · Stand 208. Wenn du bei uns am Stand warst: Hier geht es weiter.
        <span>27–29 November 2026 · Messe Berlin · Stand 208. If you visited our stand, this is where it continues.</span>
      </p>
    </div>
  </div>

  <!-- ================= BLOCK 1: AFTERCARE ================= -->
  <section class="bd-sec">
    <div class="wrap bd-narrow bd-rise">
      <div class="bd-eyebrow">Pflege · Aftercare</div>
      <h2 class="bd-h2">Dein Tattoo vom Stand heilt jetzt<span>Your tattoo from the stand is healing now</span></h2>
      <p class="bd-body">
        Die nächsten Wochen entscheiden, wie dein Motiv in einem Jahr aussieht. Unsere Pflegeanleitung erklärt jeden Schritt. Wenn dir eine Stelle komisch vorkommt, schick uns ein Foto, wir schauen es uns an.
        <span>The next few weeks decide how your design will look a year from now. Our aftercare guide explains every step. If a spot looks odd to you, send us a photo and we will take a look.</span>
      </p>
      {/* OPTION A (ND-457): only if niloo confirms ND-540 also covers stand tattoos.
      <p class="bd-body">
        Nachkontrolle und, wo eine Stelle es braucht, Nachstechen gehören auch zu deinem Tattoo vom Stand, ohne Aufpreis.
        <span>Follow-up check and, where a spot needs it, a touch-up are part of your tattoo from the stand too, at no extra cost.</span>
      </p>
      */}
      <div class="bd-links">
        <a class="bd-btn bd-btn-dark" href="/de/journal/tattoo-nachsorge/">Zur Pflegeanleitung</a>
        <a class="bd-btn bd-btn-ghost" href="/en/journal/tattoo-aftercare/" lang="en">Read the aftercare guide</a>
      </div>
    </div>
  </section>

  <!-- ================= BLOCK 2: BIGGER IDEA ================= -->
  <section class="bd-sec bd-sec-alt">
    <div class="wrap bd-narrow bd-rise">
      <div class="bd-eyebrow">Beratung · Consultation</div>
      <h2 class="bd-h2">Größere Idee? Dafür war am Stand kein Platz.<span>Bigger idea? There was no room for it at the stand.</span></h2>
      <p class="bd-body">
        Am Stand gingen nur kleine und mittlere Motive. Ein Ärmel, ein Cover-up oder ein Motiv über den ganzen Rücken braucht ein Gespräch: Idee, Stelle, Größe, wie viele Sitzungen. Das Beratungsgespräch kostet nichts.
        <span>At the stand we only did small and medium designs. A sleeve, a cover-up or a piece across your whole back needs a conversation: idea, placement, size, how many sessions. The consultation costs nothing.</span>
      </p>
      <div class="bd-links">
        <a class="bd-btn bd-btn-red" href="/de/consultation/">Beratung buchen</a>
        <a class="bd-btn bd-btn-ghost" href="/en/consultation/" lang="en">Book a consultation</a>
      </div>
    </div>
  </section>

  <!-- ================= BLOCK 3: STUDIO CODE (highlight) ================= -->
  <section class="bd-sec">
    <div class="wrap bd-rise">
      <div class="bd-highlight">
        <div class="bd-eyebrow bd-eyebrow-red">Dein Code BIKEDAYS · Your code BIKEDAYS</div>
        <p class="bd-hl-text">
          Du hast uns auf der Messe getroffen? Buche einen Termin in unserem Studio mit dem Code <b class="bd-code">BIKEDAYS</b> und bekomme 20 % Rabatt. Gültig bis 31. Januar 2027, einmal pro Person.
          <span>Met us at the fair? Book an appointment at our studio with the code <b class="bd-code">BIKEDAYS</b> and get 20% off. Valid until 31 January 2027, once per person.</span>
        </p>
        <a class="bd-btn bd-btn-light" href={STUDIO} target="_blank" rel="noopener">Studio-Termin buchen / Book a studio appointment</a>
      </div>
    </div>
  </section>

  {/* BLOCK 4 (ND-457): Weihnachten / XMAS26 — left empty until niloo's XMAS26 decision. */}

  <!-- ================= BLOCK 5: FIND US ================= -->
  <section class="bd-sec bd-sec-find">
    <div class="wrap bd-narrow bd-rise">
      <div class="bd-eyebrow bd-eyebrow-onlight">Hier findest du uns jetzt · Where to find us now</div>
      <p class="bd-find">
        Usee Tattoo · Neue Kantstraße 6 · 14057 Berlin-Charlottenburg
      </p>
      <a class="bd-btn bd-btn-ghostlight" href={MAPS} target="_blank" rel="noopener">Route planen / Get directions</a>
    </div>
  </section>

  {/* BLOCK 6 (ND-457, optional): "Drei Tage am Stand" — 3–6 real stand photos with consent. Hidden until material exists. */}

  <!-- ================= FOOTER ================= -->
  <footer class="bd-footer">
    <div class="wrap">
      <span class="bd-foot-mark">Usee<span>·</span>Tattoo</span>
      <p>Usee Tattoo · Neue Kantstraße 6 · 14057 Berlin</p>
    </div>
  </footer>

</div>

<script is:inline>
  document.documentElement.classList.add('bd-js');
  // Site header: mobile burger menu + submenu accordion + scroll state (ported from Base)
  (function () {
    var body = document.body;
    try {
      var hd = document.querySelector('header');
      addEventListener('scroll', function () { if (hd) hd.classList.toggle('scrolled', scrollY > 20); });
    } catch (e) {}
    try {
      var burger = document.getElementById('burger');
      var backdrop = document.getElementById('backdrop');
      var closeMenu = function () { body.classList.remove('menu-open'); };
      if (burger) { burger.addEventListener('click', function (ev) { ev.preventDefault(); body.classList.toggle('menu-open'); }); }
      if (backdrop) { backdrop.addEventListener('click', closeMenu); }
      document.querySelectorAll('.has-sub').forEach(function (hs) {
        var pa = hs.querySelector(':scope > a');
        if (pa && !pa.getAttribute('href')) {
          pa.addEventListener('click', function (ev) {
            ev.preventDefault();
            if (window.matchMedia('(max-width:960px)').matches) {
              var wasOpen = hs.classList.contains('open');
              document.querySelectorAll('.has-sub.open').forEach(function (o) { if (o !== hs) o.classList.remove('open'); });
              hs.classList.toggle('open', !wasOpen);
            }
          });
        }
      });
      addEventListener('hashchange', closeMenu);
      addEventListener('keydown', function (e) { if (e.key === 'Escape') closeMenu(); });
    } catch (e) {}
  })();
  (function () {
    try {
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: .14 });
      document.querySelectorAll('.bd-rise').forEach(function (el) { io.observe(el); });
    } catch (e) {
      document.querySelectorAll('.bd-rise').forEach(function (el) { el.classList.add('in'); });
    }
  })();
</script>

<style>
  .bd-page{--bd-red:#e60000;--bd-dark:#0e0d0d;background:var(--paper);color:var(--ink)}

  /* ---------- HERO ---------- */
  .bd-hero{position:relative;min-height:92vh;display:flex;align-items:center;overflow:hidden;background:var(--bd-dark)}
  .bd-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%}
  .bd-hero-shade{position:absolute;inset:0;background:
    linear-gradient(90deg,rgba(10,9,9,.9) 0%,rgba(10,9,9,.62) 45%,rgba(10,9,9,.32) 100%),
    linear-gradient(0deg,rgba(10,9,9,.7) 0%,rgba(10,9,9,0) 40%)}
  .bd-hero-inner{position:relative;z-index:2;padding-top:48px;padding-bottom:56px}
  .bd-lockup{display:flex;align-items:center;gap:22px;margin-bottom:34px}
  .bd-logo-usee{height:62px;width:auto;filter:drop-shadow(0 2px 10px rgba(0,0,0,.4))}
  .bd-x{color:rgba(244,241,234,.55);font-family:'Cormorant Garamond',serif;font-size:30px;line-height:1}
  .bd-logo-bd{height:92px;width:auto;border-radius:12px;box-shadow:0 8px 26px rgba(0,0,0,.45)}
  .bd-badge{display:inline-flex;flex-direction:column;gap:1px;align-self:flex-start;background:var(--bd-red);color:#fff;
    padding:9px 16px;border-radius:3px;font-family:'Inter',sans-serif;font-size:12px;font-weight:600;letter-spacing:.06em;line-height:1.3;margin-bottom:26px}
  .bd-badge em{font-style:normal;font-weight:400;font-size:11px;color:rgba(255,255,255,.85)}
  .bd-h1{font-family:'Cormorant Garamond',serif;font-weight:500;color:var(--paper);
    font-size:clamp(40px,6.4vw,86px);line-height:1.02;letter-spacing:.005em;max-width:17ch;margin:0}
  .bd-h1 span{display:block;font-weight:300;font-size:clamp(20px,2.6vw,34px);color:rgba(244,241,234,.72);margin-top:10px;letter-spacing:.02em}
  .bd-sub{font-family:'Inter',sans-serif;color:rgba(244,241,234,.9);font-size:clamp(15px,1.7vw,19px);line-height:1.5;margin:26px 0 0;max-width:720px}
  .bd-sub span{display:block;color:rgba(244,241,234,.62);font-size:.86em;margin-top:5px}

  /* ---------- SHARED SECTIONS ---------- */
  .bd-sec{padding:84px 0}
  .bd-sec-alt{background:var(--paper-2)}
  .bd-narrow{max-width:760px}
  .bd-head{margin-bottom:40px}
  .bd-eyebrow{font-family:'Inter',sans-serif;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--bd-red);margin-bottom:14px}
  .bd-eyebrow-red{color:var(--bd-red)}
  .bd-h2{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(30px,4.2vw,50px);line-height:1.08;color:var(--ink)}
  .bd-h2 span{display:block;font-size:.5em;color:var(--bronze-dk);margin-top:6px;letter-spacing:.01em}
  .bd-lead{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(24px,3vw,36px);line-height:1.32;color:var(--ink)}
  .bd-lead span{display:block;font-family:'Inter',sans-serif;font-size:16px;line-height:1.7;color:var(--ink-soft);margin-top:16px;font-weight:300}

  /* ---------- BUTTONS ---------- */
  .bd-btn{display:inline-block;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
    text-decoration:none;padding:17px 34px;border-radius:3px;transition:transform .3s var(--ease),background .4s var(--ease),color .4s var(--ease),box-shadow .4s var(--ease);border:1px solid transparent}
  .bd-btn:hover{transform:translateY(-2px)}
  .bd-btn-red{background:var(--bd-red);color:#fff;box-shadow:0 8px 24px rgba(230,0,0,.26)}
  .bd-btn-red:hover{background:#c90000;box-shadow:0 12px 30px rgba(230,0,0,.34)}
  .bd-btn-dark{background:var(--ink);color:var(--paper)}
  .bd-btn-dark:hover{background:#000}
  .bd-btn-light{background:var(--paper);color:var(--ink);border-color:var(--paper)}
  .bd-btn-light:hover{background:#fff}
  .bd-btn-ghostlight{background:transparent;color:var(--paper);border-color:rgba(244,241,234,.45)}
  .bd-btn-ghostlight:hover{background:var(--paper);color:var(--ink);border-color:var(--paper)}
  /* breathing room between a text block and the button that follows it */
  .bd-sub + .bd-btn{margin-top:34px}
  .bd-lead + .bd-btn{margin-top:28px}

  .bd-note{font-family:'Inter',sans-serif;font-size:13.5px;line-height:1.6;color:var(--ink-soft);margin-top:18px;max-width:640px}
  .bd-note span{display:block;color:var(--bronze-dk);opacity:.9;margin-top:3px}
  .bd-note-light{color:rgba(244,241,234,.82)}
  .bd-note-light span{color:rgba(244,241,234,.58)}
  .bd-center{text-align:center;margin-top:46px}
  .bd-center .bd-note{margin-left:auto;margin-right:auto}
  .bd-price-scope{text-align:center;margin:22px auto 0}

  .bd-code{font-family:'Inter',sans-serif;font-weight:700;letter-spacing:.08em;background:var(--bd-red);color:#fff;
    padding:2px 9px;border-radius:3px;white-space:nowrap;font-size:.92em}

  /* ---------- DANKE BODY ---------- */
  .bd-body{font-family:'Inter',sans-serif;font-size:17px;line-height:1.75;color:var(--ink);margin-top:22px;max-width:680px}
  .bd-body span{display:block;font-size:15.5px;color:var(--ink-soft);margin-top:12px}
  .bd-links{display:flex;flex-wrap:wrap;gap:14px;margin-top:32px}
  .bd-btn-ghost{background:transparent;color:var(--ink);border-color:var(--ink)}
  .bd-btn-ghost:hover{background:var(--ink);color:var(--paper)}

  /* ---------- PRICES ---------- */
  .bd-prices{display:grid;grid-template-columns:1fr 1fr;gap:26px;max-width:820px;margin:0 auto}
  .bd-price-card{background:var(--white);border:1px solid var(--line);border-top:3px solid var(--bd-red);padding:38px 34px;text-align:center}
  .bd-price-size{font-family:'Inter',sans-serif;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
  .bd-price-size span{display:block;font-weight:400;color:var(--bronze-dk);margin-top:3px;letter-spacing:.08em}
  .bd-price-amt{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(38px,5vw,54px);line-height:1;color:var(--ink);margin:18px 0 4px}
  .bd-price-from{font-family:'Inter',sans-serif;font-size:13px;color:var(--bronze-dk);letter-spacing:.04em}

  /* ---------- FLASH PLACEHOLDER ---------- */
  .bd-flash-intro{font-family:'Inter',sans-serif;font-size:15px;line-height:1.7;color:var(--ink-soft);margin-top:16px;max-width:640px}
  .bd-flash-intro span{display:block;color:var(--bronze-dk);margin-top:3px}
  .bd-flash-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px}
  .bd-flash-item{display:block;width:100%;margin:0;padding:0;border:1px solid var(--line);background:var(--white);
    cursor:zoom-in;overflow:hidden;transition:border-color .4s var(--ease),transform .4s var(--ease),box-shadow .4s var(--ease);font:inherit;color:inherit}
  .bd-flash-item:hover{border-color:var(--bd-red);box-shadow:0 12px 32px rgba(0,0,0,.09);transform:translateY(-3px)}
  .bd-flash-item img{width:100%;height:auto;display:block}
  .bd-flash-cap{display:block;font-family:'Inter',sans-serif;font-size:11px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--ink-soft);padding:14px;text-align:center;border-top:1px solid var(--line)}
  .bd-ownidea{margin-top:48px;border:1px solid var(--line);border-left:3px solid var(--bd-red);background:var(--paper-2);padding:34px 38px;text-align:center}
  .bd-ownidea-text{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(22px,2.8vw,32px);line-height:1.3;color:var(--ink);max-width:740px;margin:6px auto 0}
  .bd-ownidea-text span{display:block;font-family:'Inter',sans-serif;font-size:15px;line-height:1.6;color:var(--ink-soft);margin-top:12px}
  /* lightbox */
  .bd-lb{position:fixed;inset:0;z-index:1000;background:rgba(10,9,9,.93);display:none;align-items:center;justify-content:center;padding:28px;cursor:zoom-out}
  .bd-lb.on{display:flex}
  .bd-lb img{max-width:100%;max-height:100%;width:auto;height:auto;box-shadow:0 14px 48px rgba(0,0,0,.55)}
  .bd-flash-soon span{display:block;font-style:normal;font-family:'Inter',sans-serif;font-size:14px;letter-spacing:.04em;color:var(--ink-soft);margin-top:8px}

  /* ---------- HIGHLIGHT (studio discount) ---------- */
  .bd-highlight{background:var(--bd-dark);color:var(--paper);padding:clamp(40px,6vw,68px);border-radius:4px;text-align:center;position:relative;overflow:hidden}
  .bd-highlight::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:var(--bd-red)}
  .bd-hl-text{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(23px,3vw,34px);line-height:1.34;color:var(--paper);max-width:860px;margin:10px auto 0}
  .bd-hl-text span{display:block;font-family:'Inter',sans-serif;font-size:15.5px;line-height:1.7;color:rgba(244,241,234,.74);margin-top:16px;font-weight:300}
  .bd-highlight .bd-btn{margin-top:34px}
  .bd-highlight .bd-code{background:#fff;color:var(--bd-dark)}

  /* ---------- GIFT CARDS ---------- */
  .bd-giftbox{border:1px solid var(--line);border-left:3px solid var(--bronze);background:var(--white);padding:34px 38px}
  .bd-gift-text{font-family:'Inter',sans-serif;font-size:16px;line-height:1.75;color:var(--ink);margin:6px 0 0}
  .bd-gift-text span{display:block;color:var(--ink-soft);margin-top:12px;font-size:15px}

  /* ---------- CONDITIONS ---------- */
  .bd-sec-cond{padding:56px 0;background:var(--paper)}
  .bd-fine{font-family:'Inter',sans-serif;font-size:13px;line-height:1.7;color:var(--ink-soft);text-align:center;max-width:760px;margin:0 auto}
  .bd-fine span{display:block;color:var(--bronze-dk);margin-top:6px}

  /* ---------- FIND US ---------- */
  .bd-sec-find{background:var(--bd-dark);color:var(--paper);text-align:center}
  .bd-eyebrow-onlight{color:var(--bd-red)}
  .bd-find{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:clamp(22px,2.8vw,32px);line-height:1.4;color:var(--paper);max-width:720px;margin:0 auto}
  .bd-find span{display:block;font-family:'Inter',sans-serif;font-size:15px;color:rgba(244,241,234,.66);margin-top:12px;font-weight:300}
  .bd-sec-find .bd-btn{margin-top:30px}

  /* ---------- FOOTER ---------- */
  .bd-footer{background:#0b0a0a;color:rgba(244,241,234,.75);padding:48px 0;text-align:center}
  .bd-foot-mark{font-family:'Cormorant Garamond',serif;font-size:22px;letter-spacing:.28em;text-transform:uppercase;color:var(--paper);display:block;margin-bottom:14px}
  .bd-foot-mark span{color:var(--bd-red)}
  .bd-footer p{font-family:'Inter',sans-serif;font-size:13px;letter-spacing:.06em;color:rgba(244,241,234,.6)}

  /* ---------- REVEAL (safe: only hides when JS is present) ---------- */
  .bd-js .bd-rise{opacity:0;transform:translateY(24px)}
  .bd-js .bd-rise.in{opacity:1;transform:none;transition:opacity .9s var(--ease),transform .9s var(--ease)}

  /* ---------- RESPONSIVE ---------- */
  @media(max-width:720px){
    .bd-hero{min-height:88vh}
    .bd-hero-shade{background:linear-gradient(0deg,rgba(10,9,9,.88) 0%,rgba(10,9,9,.45) 55%,rgba(10,9,9,.35) 100%)}
    .bd-logo-usee{height:48px}
    .bd-logo-bd{height:74px}
    .bd-x{font-size:24px}
    .bd-prices{grid-template-columns:1fr}
    .bd-flash-grid{grid-template-columns:1fr}
    .bd-sec{padding:64px 0}
    .bd-btn{width:100%;text-align:center}
    .bd-center .bd-btn{width:auto}
  }
</style>
</body>
</html>
